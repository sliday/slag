/// `None` on any failure; both the window cache and the price table treat
/// that as "unknown", never as an error.
pub async fn fetch_models_body(base_url: &str) -> Option<String> {
    fetch_models_body_for("", base_url).await
}

async fn fetch_models_body_for(api_key: &str, base_url: &str) -> Option<String> {
    let url = format!("{}/models", base_url.trim_end_matches('/'));
    let client = reqwest::Client::builder()
        .timeout(Duration::from_secs(30))
        .redirect(reqwest::redirect::Policy::none())
        .build()
        .ok()?;
    let mut request = client.get(&url);
    if !api_key.is_empty() {
        request = request.bearer_auth(api_key);
    }
    let resp = request
        .header("HTTP-Referer", "https://slag.dev")
        .header("X-Title", "slag")
        .send()
        .await
        .ok()?;
    resp.status().is_success().then_some(())?;
    resp.text().await.ok()
}

/// Everything one `/models` fetch yields: context windows and prices.
#[derive(Debug, Default)]
struct ModelsIndex {
    ids: HashSet<String>,
    windows: std::collections::HashMap<String, u64>,
    prices: crate::engine::pricing::PricingTable,
}

impl ModelsIndex {
    fn parse(body: Option<&str>) -> Self {
        let Some(body) = body else {
            return Self::default();
        };
        let models = serde_json::from_str::<ModelsResponse>(body).ok();
        let ids = models
            .as_ref()
            .map(|m| m.data.iter().map(|e| e.id.clone()).collect())
            .unwrap_or_default();
        let windows = serde_json::from_str::<ModelsResponse>(body)
            .map(|m| {
                m.data
                    .into_iter()
                    .filter_map(|e| e.context_length.map(|c| (e.id, c)))
                    .collect()
            })
            .unwrap_or_default();
        Self {
            ids,
            windows,
            prices: crate::engine::pricing::parse_table(body),
        }
    fn glob_files(&self, dir: &Path, pattern: &str) -> Result<Vec<String>, SlagError> {
        let relative = dir.strip_prefix(&self.root).unwrap_or(dir);
        let explicit = relative
            .components()
            .chain(Path::new(pattern).components())
            .any(|component| {
                let name = component.as_os_str().to_string_lossy();
                name == "logs" || name == ".git" || name.starts_with("slag-anvil-")
            });
        let mut files = Vec::new();
        let mut stack = vec![(dir.to_path_buf(), PathBuf::new())];
        while let Some((current, relative)) = stack.pop() {
            let entries = std::fs::read_dir(&current)
                .map_err(|e| SlagError::Tool(format!("glob: cannot read {}: {e}", current.display())))?;
            for entry in entries.flatten() {
                let path = entry.path();
                let name = entry.file_name();
                let child = relative.join(&name);
                if path.is_dir() {
                    let hidden_heap = name == "logs" || name == ".git" || name.to_string_lossy().starts_with("slag-anvil-");
                    if !hidden_heap || explicit {
                        stack.push((path, child));
                    }
                } else if path.is_file()
                    && glob_matches(pattern, &child.to_string_lossy())
                    || path.is_file()
                        && !pattern.contains('/')
                        && child.file_name().is_some_and(|name| glob_matches(pattern, &name.to_string_lossy()))
                {
                    files.push(child.display().to_string());
                }
            }
        }
        files.sort();
        Ok(files)
    }

    /// Write full tool output to `logs/tool-results/<hash>.txt` inside the
    /// anvil and return the workspace-relative path (item 19).
    ///
    /// The name is content-addressed rather than call-id-keyed: `run_shell`
    /// has no call id at hand, and hashing means a command re-run across
    /// heats reuses one file instead of growing the anvil every retry.
    /// Best-effort — a spill that cannot be written costs the preview
    /// nothing, so a full disk degrades to plain truncation.
    async fn spill_tool_result(&self, full: &str) -> Option<String> {

    /// The race that lost a fix: the rescue fired after it was registered
    /// and before the swap, so it restored nothing, and the swap then wrote
    /// the originals over the fix for good. Now the swap sees the rescue
    /// and never starts.
    #[tokio::test]
    async fn a_rescue_between_register_and_swap_leaves_the_fix_on_disk() {
        let (_dir, job, before, changed) = fixed_repo();
        let fire_at_once = |hook: Box<dyn FnOnce() + Send>| hook();
        let rescuer = Rescuer { register: &fire_at_once, stop: no_stop };

        let repro = reproduce(&job, &before, &changed, "bash tests/check.sh", None, &rescuer).await.0;
        assert_eq!(repro, Repro::NotShown("interrupted".into()));
        assert_eq!(value(&job), "2\n", "the fix is on disk");
    }

    /// A rescue while the check runs puts the fix back, and the end of the
    /// check does not write over it again.
    #[tokio::test]
    async fn a_rescue_during_the_check_puts_the_fix_back() {
        let (_dir, job, before, changed) = fixed_repo();
        let slot = Slot::default();
        let keep = |hook| *slot.lock().unwrap() = Some(hook);
        let rescuer = Rescuer { register: &keep, stop: no_stop };

        let check = "echo seen > seen.txt; sleep 1; bash tests/check.sh";
        let (repro, during) = tokio::join!(
            reproduce(&job, &before, &changed, check, None, &rescuer),
            async {
                while !job.cwd.join("seen.txt").exists() {
                    tokio::time::sleep(Duration::from_millis(10)).await;
                }
                let during = value(&job);
                fire(&slot);
                during
            }
        );
        assert_eq!(during, "1\n", "the originals were on disk during the check");
        assert_eq!(repro.0, Repro::NotShown("interrupted".into()));
        assert_eq!(value(&job), "2\n", "the rescue put the fix back");
    }

    /// The TUI critic's case: `a + b` and `a * b` have the same size, and
    /// Python trusts a `.pyc` whose recorded mtime second and size match
    /// the source. After a swap inside one second the old bytecode ran,
    /// and the suite failed right after slag printed FIXED.
    #[tokio::test]
    async fn a_same_size_same_second_swap_leaves_no_stale_bytecode() {
        let dir = tempfile::tempdir().unwrap();
        let root = dir.path();
        let old = "def f(a, b):\n    return a + b\n";

