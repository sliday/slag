        - :grade = 1-5 complexity (3+ gets plan mode)\n\
        - :skill = web|api|cli|default (selects tools/plugins)\n\
        - :heat = 0\n\
            "  {}{:<5} {:<3} {:<4} {:<7} {}{}",
