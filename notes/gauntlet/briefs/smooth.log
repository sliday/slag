+        for cleanup in taken.into_iter().rev() {
+            let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(cleanup));
+        }
+        n
+    }
+
+    fn pending(&self) -> usize {
+        self.cleanups.lock().unwrap_or_else(|e| e.into_inner()).len()
+    }
+}
+
