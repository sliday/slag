+                let child = relative.join(&name);
+                if path.is_dir() {
+                    let hidden_heap = name == "logs" || name == ".git" || name.to_string_lossy().starts_with("slag-anvil-");
+                    if !hidden_heap || explicit {
+                        stack.push((path, child));
+                    }
