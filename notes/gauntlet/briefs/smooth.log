+    }
+
+    fn register<F: FnOnce() + Send + 'static>(&self, f: F) {
+        self.cleanups.lock().unwrap_or_else(|e| e.into_inner()).push(Box::new(f));
+    }
+
+    fn run_all(&self) -> usize {
