+            Some(b'?') => path.first().is_some_and(|b| *b != b'/' && matches(&pattern[1..], &path[1..])),
+            Some(b) => path.first() == Some(b) && matches(&pattern[1..], &path[1..]),
+        }
+    }
+
+    matches(pattern.as_bytes(), path.as_bytes())
