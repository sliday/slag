tokenize, top_words as tw; a = chr(39); assert _tokenize(\\\"Don\\\" + a + \\\"t stop, 42 _x\\\") == [\\\"don\\\" + a + \\\"t\\\", \\\"stop\\\", \\\"42\\\", \\\"x\\\"]; assert tw(\\\"b a b a c\\\", 2) == [(\\\"a\\\", 2), (\\\"b\\\", 2)]'\" :work \"Goal: implement the pure text core in textstats/core.py (currently empty). Why: cli.py and both test suites depend on these exact signatures and tie-break behaviour. Steps: (1) first line `from __future__ import annotations`, then `import re` and `from collections import Counter`. (2) _tokenize(text: str) -> list[str]: return re.findall(PATTERN, text.lower()), where PATTERN is the raw regex in BLUEPRINT.md section 2 C2, copied exactly (single backslashes, character class excluding underscore, apostrophe-contraction group). Do not double any backslash. (3) word_count(text: str) -> int returns len(_tokenize(text)). (4) unique_words(text: str) -> int returns len(set(_tokenize(text))). (5) top_words(text: str, n: int) -> list[tuple[str, int]]: if n <= 0 return []; counts = Counter(_tokenize(text)); return sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))[:n]. (6) textstats/__init__.py already holds the __version__ line from i1: add one line `from .core import word_count, unique_words, top_words` and keep __version__ intact. Ruled out: third-party imports, match statements, changes to cli.py or tests, comments beyond necessity. Python 3.9 compatible.\")\n(ingot :id \"i4\" :status forged :solo nil :grade 2 :skill default :heat 1 :max 5 :smelt 0 :proof \"python3 -m unittest discover -s tests -p test_core.py\" :work \"Goal: pin the core API with unittest so regressions in tokenizer or tie-break fail loudly. Why: the tokenizer regex and sort key are the only subtle logic in the package. Write tests/test_core.py (currently empty) using unittest.TestCase, importing from textstats.core (import word_count, unique_words, top_words, _tokenize as needed). Add `if __name__ == \\\"__main__\\\": unittest.main()` at the bottom. Required 