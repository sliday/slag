    }
}

fn openai_reasoning_model(model: &str) -> bool {
    model == "o1" || model.starts_with("o1-")
        || model == "o3" || model.starts_with("o3-")
        || model == "o4" || model.starts_with("o4-")
        || model.starts_with("gpt-5")
}

fn reasoning_effort(provider: ProviderPreset, model: &str, effort: super::Effort) -> Option<&'static str> {
    match provider {
        ProviderPreset::OpenAI if openai_reasoning_model(model) && !model.starts_with("o1-preview")
            && !model.starts_with("o1-mini") && !model.contains("-chat-") => Some(effort.as_str()),
use crate::error::SlagError;

fn broken_shell_exit(code: Option<i32>, stderr: &str) -> bool {
    matches!(code, Some(126 | 127)) || (code == Some(2) && stderr.lines().any(|line| {
        (line.starts_with("bash:") || line.contains(": line ") || line.contains(": -c:"))
            && (line.contains("syntax error") || line.contains("unexpected EOF")
                || line.contains("unexpected end of file"))
    }))
}

pub struct ShellCheck {
    pub success: bool,
    pub output: String,
    pub broken: bool,
    pub reason: String,
}

pub async fn check_shell(cmd: &str) -> ShellCheck {
    check_shell_in(cmd, std::path::Path::new(".")).await
}

/// Extract `CMD: <command>` from smith response text.
/// Takes the last CMD: line found (smith may output multiple).
pub fn extract_cmd(response: &str) -> Option<String> {
    response
        .lines()
        .map(str::trim_start)
        .filter(|line| line.starts_with("CMD:"))
        .last()
        .map(|line| line.strip_prefix("CMD:").unwrap().trim().to_string())
}

/// Run a shell command and return (success, output).
pub async fn run_shell(cmd: &str) -> (bool, String) {
    run_shell_in(cmd, std::path::Path::new(".")).await
}

/// `run_shell` in `dir`. A model writes proofs and CMD lines, so they run
/// under the smith's shell sandbox rooted at `dir`. A refused write leads
/// the output, so the failed heat names it instead of showing a mystery.
pub async fn run_shell_in(cmd: &str, dir: &std::path::Path) -> (bool, String) {
    let result = check_shell_in(cmd, dir).await;
    (result.success, result.output)
}

async fn check_shell_in(cmd: &str, dir: &std::path::Path) -> ShellCheck {
    let root = dir.canonicalize().unwrap_or_else(|_| dir.to_path_buf());
    let sandbox = crate::engine::sandbox::Sandbox::for_root(&root);
    match sandbox.wrap("bash").args(["-c", cmd]).current_dir(dir).output().await {
        Ok(output) => {
            let stdout = String::from_utf8_lossy(&output.stdout);
            let stderr = String::from_utf8_lossy(&output.stderr);
            let combined = format!("{stdout}{stderr}");
            let ok = output.status.success();
            let broken = broken_shell_exit(output.status.code(), &stderr);
            let reason = stderr.lines().find(|l| !l.trim().is_empty())
                .or_else(|| if broken { None } else { stdout.lines().find(|l| !l.trim().is_empty()) })
                .map(str::trim).map(str::to_string)
                .unwrap_or_else(|| match output.status.code() {
                    Some(code) => format!("shell exited with status {code}"),
                    None => "shell terminated by a signal".into(),
                });
            let output = match sandbox.denial_note(&combined, !ok) {
                Some(note) => (ok, format!("{note}\n{combined}")),
                None => (ok, combined),
            };
            ShellCheck { success: ok, output: output.1, broken, reason }
        }
        Err(e) => {
            let reason = format!("spawn error: {e}");
            ShellCheck { success: false, output: reason.clone(), broken: false, reason }
        }
    }
}

/// Verify an ingot's proof command.
/// Returns Ok(()) if proof passes, Err with reason if it fails.
pub async fn verify_proof(proof: &str, id: &str) -> Result<(), SlagError> {
    if proof.is_empty() || proof == "true" {
        return Ok(());
    }

    let (success, output) = run_shell(proof).await;
    if success {
        Ok(())
    } else {
        Err(SlagError::ProofFailed {
            id: id.to_string(),
            reason: output,
        })
        let mut name = self.path.file_name().map(|n| n.to_os_string()).unwrap_or_default();
        name.push(".tmp");
        self.path.with_file_name(name)
    }

    /// Save crucible to disk. Atomic: write a temp file, then rename, so a
    /// concurrent load never sees a half-written or truncated file.
    pub fn save(&self) -> Result<(), std::io::Error> {
        let tmp = self.tmp_path();
        std::fs::write(&tmp, self.render())?;
        std::fs::rename(&tmp, &self.path)
    }

    /// Async save (for use in tokio context)
    pub async fn save_async(&self) -> Result<(), std::io::Error> {
        let tmp = self.tmp_path();
        tokio::fs::write(&tmp, self.render()).await?;
        tokio::fs::rename(&tmp, &self.path).await
    }

    /// Add newly cast ingots to an existing crucible, renumbering them
    /// past the highest id already in use.
    ///
    /// A second commission on a live project must not cost the record of
    /// the first: `Crucible::new` replaces the file wholesale, so founding
    /// again over a finished plan would erase every forged ingot. Ingots
    /// carry no references to each other, so renumbering is safe; ids are
    /// unique handles, not links.
    pub fn append(&mut self, ingots: Vec<Ingot>) -> usize {
        let mut next = self
            .ingots
            .iter()
            .filter_map(|i| i.id.trim_start_matches('i').parse::<usize>().ok())
            .max()
            .unwrap_or(0)
            + 1;
        let added = ingots.len();
        for mut ingot in ingots {
            ingot.id = format!("i{next}");
            next += 1;
            self.ingots.push(ingot);
        }
        added
    }

    /// Find ingot by id
    pub fn get(&self, id: &str) -> Option<&Ingot> {
        self.ingots.iter().find(|i| i.id == id)
    }

    /// Find mutable ingot by id
    pub fn get_mut(&mut self, id: &str) -> Option<&mut Ingot> {
        self.ingots.iter_mut().find(|i| i.id == id)
    }

    /// Set status for an ingot by id
    pub fn set_status(&mut self, id: &str, status: Status) {
        if let Some(ingot) = self.get_mut(id) {
            ingot.status = status;
        }
    }

    /// Increment heat for an ingot
    pub fn increment_heat(&mut self, id: &str) {
        if let Some(ingot) = self.get_mut(id) {
            ingot.heat += 1;
        }
    }

    /// Get next ore ingot (any)
    pub fn next_ore(&self) -> Option<&Ingot> {
        self.ingots.iter().find(|i| i.status == Status::Ore)
    }

    /// Get all solo ore ingots (can run in parallel)
    pub fn solo_ore(&self) -> Vec<&Ingot> {
        self.ingots
            .iter()
            .filter(|i| i.status == Status::Ore && i.solo)
            .collect()
    }

    /// Get sequential ore ingots (solo=nil)
    pub fn sequential_ore(&self) -> Option<&Ingot> {
        self.ingots
            .iter()
            .find(|i| i.status == Status::Ore && !i.solo)
    }

    /// Replace ingot(s) by id. If replacement is multiple ingots (split), all are inserted.
    pub fn replace(&mut self, id: &str, replacements: Vec<Ingot>) {
        if let Some(idx) = self.ingots.iter().position(|i| i.id == id) {
            self.ingots.remove(idx);
            for (offset, ingot) in replacements.into_iter().enumerate() {
                self.ingots.insert(idx + offset, ingot);
            }
        }
    }

    /// Count ingots by status
    pub fn counts(&self) -> CrucibleCounts {
            },
            (None, _) => "killed".to_string(),
        }
    }

    /// The command could not run at all here: the shell found no such
    /// program, or it never finished. Neither says anything about the bug.
    pub fn unusable(&self) -> bool {
        self.timed_out || self.code == Some(127)
    }
}

/// Run `cmd` under bash in `dir`, stdout and stderr interleaved as a
/// terminal would show them. `CI=true` keeps watch-mode runners from
/// waiting on a keypress that never comes. `PYTHONDONTWRITEBYTECODE`
/// keeps slag's own runs from leaving `.pyc` files behind: the
/// reproduction check compiles the old source, and a cache entry from it
/// can outlive the swap back (see `purge_bytecode`). The session can rewrite the
/// test scripts this runs, so it runs in the smith's shell sandbox; a
/// refused write ends the output with the sandbox's note.
pub async fn run(cmd: &str, dir: &Path, timeout: Duration) -> Run {
    let start = Instant::now();
    let root = dir.canonicalize().unwrap_or_else(|_| dir.to_path_buf());
    let sandbox = crate::engine::sandbox::Sandbox::for_root(&root);
    let mut command = sandbox.wrap("bash");
    command
        .arg("-c")
        .arg(format!("exec 2>&1\n{cmd}"))
        .current_dir(dir)
        .env("CI", "true")
        .env("PYTHONDONTWRITEBYTECODE", "1")
        .stdin(Stdio::null())
        .stdout(Stdio::piped())
        .stderr(Stdio::piped())
        .kill_on_drop(true);
    #[cfg(unix)]
    command.process_group(0);
    let child = match command.spawn() {
        Ok(child) => child,
        Err(e) => {
            return Run {
                cmd: cmd.to_string(),
                code: None,
                output: format!("could not start bash: {e}"),
                secs: 0.0,
                timed_out: false,
            }
        }
    };
    let pid = child.id();
    if let Some(pid) = pid {
        running().lock().unwrap_or_else(|e| e.into_inner()).push(pid);
    }
    let waited = tokio::time::timeout(timeout, child.wait_with_output()).await;
    if let Some(pid) = pid {
        running().lock().unwrap_or_else(|e| e.into_inner()).retain(|p| *p != pid);
    }
    let secs = start.elapsed().as_secs_f64();
    match waited {
        Ok(Ok(out)) => {
            let mut output = String::from_utf8_lossy(&out.stdout).into_owned();
            output.push_str(&String::from_utf8_lossy(&out.stderr));
            if let Some(note) = sandbox.denial_note(&output, !out.status.success()) {
                if !output.is_empty() && !output.ends_with('\n') {
                    output.push('\n');
                }
                output.push_str(&note);
            }
            Run { cmd: cmd.to_string(), code: out.status.code(), output, secs, timed_out: false }
        }
        Ok(Err(e)) => Run {
            cmd: cmd.to_string(),
            code: None,
            output: format!("wait failed: {e}"),
            secs,
            timed_out: false,
        },
        Err(_) => {
            // kill_on_drop reaches bash only; the test runner it started
            // lives in the same process group.
            if let Some(pid) = pid {
                kill_group(pid);
            }
            Run { cmd: cmd.to_string(), code: None, output: String::new(), secs, timed_out: true }
        }
    }
}

/// Process groups of the commands running right now. A Ctrl-C exits the
/// process without dropping anything, so `kill_on_drop` never fires there;
/// this list is what the shutdown path kills instead. `slag fix` registers
/// `kill_running` with the shutdown hooks; nothing here touches them, so
/// a unit test's commands cannot be killed by another test's shutdown.
fn running() -> &'static std::sync::Mutex<Vec<u32>> {
    static RUNNING: std::sync::OnceLock<std::sync::Mutex<Vec<u32>>> = std::sync::OnceLock::new();
    RUNNING.get_or_init(|| std::sync::Mutex::new(Vec::new()))
}

/// Kill every command slag started and has not seen finish. Called before
/// any file is restored on the way out, so a test run cannot write over
/// the restore.
pub fn kill_running() {
    let pids = std::mem::take(&mut *running().lock().unwrap_or_else(|e| e.into_inner()));
    for pid in pids {
        kill_group(pid);
    }
}

/// The shell's builtin `kill`, not the binary: procps `kill` reads
/// `-KILL -<pid>` as a kill of every process the user can signal, so a
/// timed-out test took the whole session down on Linux.
fn kill_group(pid: u32) {
    let _ = std::process::Command::new("sh")
        .arg("-c")
        .arg(format!("kill -9 -{pid}"))
        .stderr(Stdio::null())
        .status();
}

/// Drop the cached bytecode of a Python source file. Python trusts a
/// `.pyc` whose recorded mtime (whole seconds) and size match the source,
/// so swapping `a + b` for `a * b` within one second leaves a cache entry
/// that runs the wrong code. Deleting the entry forces a recompile; it is
/// only a cache.
pub fn purge_bytecode(path: &Path) {
    if path.extension().and_then(|e| e.to_str()) != Some("py") {
        return;
    }
    let (Some(dir), Some(stem)) = (path.parent(), path.file_stem().and_then(|s| s.to_str())) else {
        return;
    };
pub fn unescape(s: &str) -> String {
    s.replace("\\\"", "\"").replace("\\\\", "\\")
}

/// The commission as one line: PRD.md's last non-empty line, which is
/// where `fire_furnace` writes it.
fn commission(prd: &str) -> Option<String> {
    prd.lines().map(str::trim).rfind(|l| !l.is_empty() && !l.starts_with('#')).map(str::to_string)
}

/// A spend ledger row as a reader wants it: the call site first, then
/// what it burned, then the model without its vendor prefix.
/// `anthropic/claude-haiku-5.5  smith  1619164 tok  $0.1784`
/// → `smith      1.6M tok  $0.18  claude-haiku-5.5`.
fn ledger_row(row: &str) -> String {
    let parts: Vec<&str> = row.split_whitespace().collect();
    match parts.as_slice() {
        [model, role, n, "tok", cost @ ..] => {
            let tok = n.parse::<u64>().map(tui::tokens).unwrap_or_else(|_| n.to_string());
            let dollars = cost
                .first()
                .and_then(|c| c.trim_start_matches('$').parse::<f64>().ok())
                .map(tui::money)
                .unwrap_or_else(|| cost.join(" "));
            let model = model.rsplit('/').next().unwrap_or(model);
            format!("{role:<9} {tok:>6} tok  {dollars:<7} {model}")
        }
        _ => parts.join(" "),
    }
}

        })
        .collect()
}

/// slag spells booleans `t`/`nil` in ingots; config files reach for
/// `true`/`1`/`yes`. Accept all of them, and treat `nil`/`false`/`0`/`off`
/// as the explicit no.
pub fn truthy(value: &str) -> bool {
    matches!(
        value.trim().to_ascii_lowercase().as_str(),
        "t" | "true" | "1" | "yes" | "on"
    )
}

fn file_value(entries: &[(String, String)], key: &str) -> Option<String> {
    entries
        .iter()
        .find(|(k, _)| k == key)
        .map(|(_, v)| v.clone())
}

