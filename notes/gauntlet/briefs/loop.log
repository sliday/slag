+                let n = body["messages"].as_array().unwrap().iter()
+                    .filter(|m| m["role"] == "tool").count();
+                let calls = match n {
+                    0 => vec![
+                        ("glob", serde_json::json!({"pattern": "**/*"})),
+                        ("grep", serde_json::json!({"pattern": "."})),
+                    ],
+                    2 => vec![
+                        ("glob", serde_json::json!({"pattern": "*.txt", "path": "logs"})),
+                        ("grep", serde_json::json!({"pattern": "needle", "path": "logs"})),
+                        ("read_file", serde_json::json!({"path": "logs/heap.txt"})),
+                    ],
+                    _ => vec![],
+                };
+                let (message, finish) = if calls.is_empty() {
+                    (serde_json::json!({"content": "CMD: true"}), "stop")
+                } else {
+                    let tools: Vec<_> = calls.into_iter().enumerate().map(|(i, (name, args))| {
+                        serde_json::json!({"id": format!("tool-{n}-{i}"), "type": "function",
+                            "function": {"name": name, "arguments": args.to_string()}})
+                    }).collect();
+                    (serde_json::json!({"content": null, "tool_calls": tools}), "tool_calls")
+                };
+                ResponseTemplate::new(200).set_body_json(serde_json::json!({
+                    "choices": [{"message": message, "finish_reason": finish}]
+                }))
+            }).expect(3).mount(&server).await;
+        let mut cmd = forge(root.path(), config.path(), &server.uri(), "off");
+        if fallback {
