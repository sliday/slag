            if let Some(word) = cli.suspect_verb().filter(|_| !cli.force) {
                tui::show_banner();
                println!(
                    "  {}! `slag {word}` is not a subcommand{}",
                    fg(tui::WARM),
                    reset()
                );
                if let Some(near) = cli::nearest_subcommand(word) {
                    println!("    did you mean `slag {near}`?");
                }
                println!("    subcommands: {}", cli::SUBCOMMANDS.join(", "));
