+        .mount(&server)
+        .await;
+    forge(root.path(), config.path(), &server.uri(), "off").assert().success();
+    assert_eq!(std::fs::read_to_string(root.path().join("hello.py")).unwrap(), "print('hello')\n");
+    assert_eq!(std::fs::read_to_string(root.path().join("proof-runs")).unwrap(), "checked");
+    command(root.path(), config.path(), &server.uri(), "off")
