+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::sexp::Status;
+    use crate::smith::mock::MockSmith;
+
+    #[tokio::test]
+    async fn resmelt_owns_status_heat_and_smelt_for_rewrites_and_splits() {
+        let dir = tempfile::tempdir().unwrap();
+        for response in [
+            "(ingot :id \"i1\" :status molten :heat 99 :smelt 0)",
+            "(ingot :id \"i1a\" :status forged :heat 4 :smelt 0)\n\
+             (ingot :id \"i1b\" :status cracked :heat 5 :smelt 9)",
+        ] {
+            let ingot = parse_crucible("(ingot :id \"i1\" :status molten :heat 5)").remove(0);
+            let mut crucible = Crucible::new(&dir.path().join("PLAN.md"), vec![ingot.clone()]);
+            let smith = MockSmith::fixed(response);
+            resmelt_ingot(&mut crucible, &ingot, &smith).await.unwrap();
+            for replacement in crucible.ingots.clone() {
+                assert_eq!(replacement.status, Status::Ore);
+                assert_eq!(replacement.heat, 0);
+                assert_eq!(replacement.smelt, 1);
+                resmelt_ingot(&mut crucible, &replacement, &smith).await
+                    .expect_err("a replacement gets one re-smelt");
+            }
+            assert_eq!(smith.call_count(), 1);
+        }
+    }
+
+    #[tokio::test]
+    async fn resmelt_rejects_duplicate_or_colliding_replacement_ids() {
+        let dir = tempfile::tempdir().unwrap();
+        for response in [
+            "(ingot :id \"i1\")\n(ingot :id \"i1\")",
+            "(ingot :id \"i2\")",
+        ] {
+            let ingots = parse_crucible("(ingot :id \"i1\" :status molten :heat 5)\n\
+                (ingot :id \"i2\" :status forged)");
+            let original = ingots[0].clone();
+            let mut crucible = Crucible::new(&dir.path().join("PLAN.md"), ingots);
+            resmelt_ingot(&mut crucible, &original, &MockSmith::fixed(response)).await
+                .expect_err("re-smelt cannot alias another ingot");
+            assert_eq!(crucible.ingots.len(), 2);
+            assert_eq!(crucible.get("i1").unwrap().heat, 5);
+            assert_eq!(crucible.get("i2").unwrap().status, Status::Forged);
+        }
+    }
+}
diff --git a/slag-rs/tests/forge_loop.rs b/slag-rs/tests/forge_loop.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f685e3d9d542e98030966a8033fc7bd898d5c7d2
--- /dev/null
+++ b/slag-rs/tests/forge_loop.rs
@@ -0,0 +1,127 @@
+use std::path::Path;
+use std::time::Duration;
+
+use assert_cmd::Command;
+use predicates::str::contains;
+use wiremock::matchers::{method, path};
+use wiremock::{Mock, MockServer, ResponseTemplate};
+
+fn project(plan: &str) -> tempfile::TempDir {
+    let dir = tempfile::tempdir().unwrap();
+    for (name, content) in [
+        ("PRD.md", "Print hello.\n"),
+        ("BLUEPRINT.md", "Create hello.py.\n"),
+        ("PLAN.md", plan),
+    ] {
+        std::fs::write(dir.path().join(name), content).unwrap();
+    }
+    for args in [
+        vec!["init", "-b", "main"],
+        vec!["config", "user.email", "forge@slag.test"],
+        vec!["config", "user.name", "slag"],
+        vec!["commit", "--allow-empty", "-m", "base"],
+    ] {
+        let out = std::process::Command::new("git")
+            .args(args).current_dir(dir.path()).output().unwrap();
+        assert!(out.status.success(), "{out:?}");
+    }
+    dir
+}
+
+fn forge(root: &Path, config: &Path, base: &str, duel: &str) -> Command {
+    let mut cmd = Command::new(env!("CARGO_BIN_EXE_slag"));
+    cmd.env_clear()
+        .env("PATH", std::env::var_os("PATH").unwrap())
+        .env("GIT_CONFIG_GLOBAL", "/dev/null")
+        .env("GIT_CONFIG_NOSYSTEM", "1")
+        .env("OPENROUTER_API_KEY", "sk-or-test")
+        .env("SLAG_CONFIG_DIR", config)
+        .env("SLAG_OPENROUTER_BASE", base)
+        .env("SLAG_MODEL_BASE", "test/base")
+        .env("SLAG_MODEL_PLAN", "test/plan")
+        .env("SLAG_MODEL_ALT", "test/alt")
+        .env("SLAG_DUEL", duel)
+        .env("SLAG_DUEL_ROUNDS", "1")
+        .env("NO_COLOR", "1")
+        .current_dir(root)
+        .timeout(Duration::from_secs(10))
+        .arg("resume");
+    cmd
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn cracked_ingot_with_a_phantom_queue_stops_before_another_duel() {
+    let plan = "(ingot :id \"i1\" :status cracked :solo t :heat 5 :max 5 :smelt 1)\n\
+        (ingot :id \"i1\" :status ore :solo t :heat 0 :max 5)\n";
+    let root = project(plan);
+    let config = tempfile::tempdir().unwrap();
+    let server = MockServer::start().await;
+    Mock::given(method("POST")).and(path("/chat/completions"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(serde_json::json!({
+            "choices": [{"message": {"content": "Created hello.py."}, "finish_reason": "stop"}]
+        })))
+        .expect(0).mount(&server).await;
+    forge(root.path(), config.path(), &server.uri(), "on")
+        .assert().failure().stderr(contains("duplicate ingot id"));
+    assert_eq!(std::fs::read_to_string(root.path().join("PLAN.md")).unwrap(), plan);
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn terminal_ingots_never_reach_an_anvil() {
+    let plan = "(ingot :id \"i1\" :status cracked :solo t :heat 5 :max 5 :smelt 1)\n\
+        (ingot :id \"i2\" :status forged :solo nil :heat 1 :max 5)\n";
+    let root = project(plan);
+    let config = tempfile::tempdir().unwrap();
+    let server = MockServer::start().await;
+    Mock::given(method("POST")).and(path("/chat/completions"))
+        .respond_with(ResponseTemplate::new(200))
+        .expect(0).mount(&server).await;
+    forge(root.path(), config.path(), &server.uri(), "on")
+        .assert().failure().stderr(contains("1 ingots cracked"));
+    assert_eq!(std::fs::read_to_string(root.path().join("PLAN.md")).unwrap(), plan);
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn missing_cmd_after_resmelt_cracks_once_and_resume_spends_nothing() {
+    let root = project("(ingot :id \"i1\" :status ore :solo t :heat 0 :max 5 :smelt 0)\n");
+    let config = tempfile::tempdir().unwrap();
+    let server = MockServer::start().await;
+    Mock::given(method("POST")).and(path("/chat/completions"))
+        .respond_with(|request: &wiremock::Request| {
+            let body: serde_json::Value = serde_json::from_slice(&request.body).unwrap();
+            let prompt = body["messages"].as_array().unwrap().last().unwrap()["content"]
+                .as_str().unwrap();
+            let content = if prompt.contains("=== RE-SMELT ANALYSIS ===") {
+                "REWRITE:\n(ingot :id \"i1\" :status ore :solo t :heat 0 :max 5 :smelt 0)"
+            } else {
+                "Created hello.py."
+            };
+            ResponseTemplate::new(200).set_body_json(serde_json::json!({
+                "choices": [{"message": {"content": content}, "finish_reason": "stop"}]
+            }))
+        })
+        .expect(13).mount(&server).await;
+    forge(root.path(), config.path(), &server.uri(), "on")
+        .assert().failure().stderr(contains("1 ingots cracked"));
+    let plan = std::fs::read_to_string(root.path().join("PLAN.md")).unwrap();
+    assert!(plan.contains(":status cracked"), "{plan}");
+    assert!(plan.contains(":heat 5 :max 5 :smelt 1"), "{plan}");
+    forge(root.path(), config.path(), &server.uri(), "on")
+        .assert().failure().stderr(contains("1 ingots cracked"));
+    assert_eq!(std::fs::read_to_string(root.path().join("PLAN.md")).unwrap(), plan);
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+#[cfg(debug_assertions)]
+async fn unchanged_pass_stops_panicked_anvils_without_provider_calls() {
+    let root = project("(ingot :id \"i1\" :status molten :solo t :heat 255 :max 5 :smelt 1)\n");
+    let config = tempfile::tempdir().unwrap();
+    let server = MockServer::start().await;
+    Mock::given(method("POST")).and(path("/chat/completions"))
+        .respond_with(ResponseTemplate::new(200))
+        .expect(0).mount(&server).await;
+    forge(root.path(), config.path(), &server.uri(), "off")
+        .assert().failure().stderr(contains("forge made no progress"));
+    let plan = std::fs::read_to_string(root.path().join("PLAN.md")).unwrap();
+    assert!(plan.contains(":heat 255"), "{plan}");
+}

