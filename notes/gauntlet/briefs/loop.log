+    log_to_file(&format!("PROOF_{}_{heat}", ingot.id),
+        &format!("exit=1\n{}\n{}", check.reason, check.output));
+    emit(&hooks.events, EngineEvent::Warning { message: format!("[{}] {reason}", ingot.id) });
