            "write_file" => self.write_file(&args).await,
            "edit_file" => self.edit_file(&args).await,
            "bash" => self.bash(&args).await,
            "grep" => self.grep(&args).await,
            "glob" => self.glob(&args).await,
            "recipe_view" => self.recipe_view(&args).await,
