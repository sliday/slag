+                        }).to_string()
+                    }
+                }]})
+            } else {
+                serde_json::json!({"content": "(ingot :id \"i1\" :status forged :heat 99 :smelt 9 :max 1 :proof \"printf checked >> proof-runs; test -f hello.py\" :work \"Verify hello.py\")"})
+            };
