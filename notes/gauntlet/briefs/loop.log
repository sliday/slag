        let win_dir = worktree::create_in(&repo, "i6-r1a").await.unwrap();
        worktree::create_in(&repo, "i6-r1b").await.unwrap();
        std::fs::write(win_dir.join("won.txt"), "winner\n").unwrap();

        let ingot = ingot("i6", true, 4, None, "true");
        let err = crown(
            &repo,
