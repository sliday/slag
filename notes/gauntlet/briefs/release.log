     --repo "$REPO" \
     --title "$TITLE" \
     --notes "$NOTES" \
-    "$TARBALL" \
-    "$RAW" \
-    sha256.sum
+    "${assets[@]}"
 
 echo "Published. Verify with: slag update (should report already up to date)"

