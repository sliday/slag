-    shasum -a 256 "$TARBALL" "$RAW" > sha256.sum
+    selected_targets=("${TARGETS[@]}")
+    if [ "${2:-}" = "--target" ]; then
+        [ -n "${3:-}" ] || { echo "Usage: $0 --build [--target <triple>]" >&2; exit 1; }
+        selected_targets=("$3")
+    elif [ -n "${2:-}" ]; then
+        echo "Usage: $0 --build [--target <triple>]" >&2
