+            bin="$CRATE_DIR/target/$target/release/slag"
+            if [ ! -x "$bin" ]; then
+                bin="$CRATE_DIR/target/$build_target/release/slag"
+            fi
+            ;;
+        *)
+            echo "Error: unsupported target $target. Choose one of: ${TARGETS[*]}" >&2
+            exit 1
+            ;;
