+        done
+    else
+        echo "  Docker unavailable, skipped Linux runtime checks. Start Docker and rerun --build to enable them."
+    fi
     echo "Assets ready:"
     sed 's/^/  /' sha256.sum
-    ./slag --version
-    echo "Commit these with the version bump, then publish."
