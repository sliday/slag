  ```
  # runs "$@" with TIMEOUT seconds; sets RC and TIMED_OUT
  run_with_timeout() {
    TIMED_OUT=0
    if command -v gtimeout >/dev/null 2>&1; then
      gtimeout -k 5 "$TIMEOUT" "$@"
      RC=$?
      [ "$RC" -eq 124 ] && TIMED_OUT=1
      return
    fi
    "$@" &
    local pid=$!
    local marker
    marker=$(mktemp -t benchwatch)
    rm -f "$marker"
    ( sleep "$TIMEOUT"; if kill -0 "$pid" 2>/dev/null; then touch "$marker"; kill -TERM "$pid" 2>/dev/null; sleep 3; pkill -KILL -P "$pid" 2>/dev/null; kill -KILL "$pid" 2>/dev/null; fi ) &
    local wd=$!
    wait "$pid"; RC=$?
    kill "$wd" 2>/dev/null; wait "$wd" 2>/dev/null
    [ -f "$marker" ] && TIMED_OUT=1
    rm -f "$marker"
  }
  ```
