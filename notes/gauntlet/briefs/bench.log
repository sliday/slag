  ```bash
  #!/usr/bin/env bash
  # bench/run.sh - issue-solving benchmark runner.
  # Usage: bench/run.sh --agent <adapter> [--tasks id1,id2] [--timeout 600] [--runs 1] [--out results.json]
  #        bench/run.sh --verify-fixtures
  set -u

  BENCH_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  ISSUES_DIR="$BENCH_DIR/issues"

  AGENT=""
  TASKS=""
  TIMEOUT=600
  RUNS=1
  OUT=""
  VERIFY=0

  usage() { ... }

  while [ $# -gt 0 ]; do
    case "$1" in
      --agent) AGENT=$2; shift 2;;
      --tasks) TASKS=$2; shift 2;;
      --timeout) TIMEOUT=$2; shift 2;;
      --runs) RUNS=$2; shift 2;;
      --out) OUT=$2; shift 2;;
      --verify-fixtures) VERIFY=1; shift;;
      -h|--help) usage; exit 0;;
      *) echo "unknown arg: $1" >&2; usage; exit 2;;
    esac
  done
  ```

