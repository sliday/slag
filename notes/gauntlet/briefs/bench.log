  lexer:
  ```rust
  #[derive(Debug, Clone, PartialEq, Eq)]
  pub enum Token {
      Word { line: usize, text: String },
      Equals { line: usize },
  }

  pub fn lex(src: &str) -> Vec<Token> {
      let mut tokens = Vec::new();
      let mut line = 1usize;
      let mut chars = src.chars().peekable();
      while let Some(&c) = chars.peek() {
          match c {
              '\n' => { line += 1; chars.next(); }
              ' ' | '\t' | '\r' => { chars.next(); }
              '#' => {
                  while let Some(&c2) = chars.peek() {
                      chars.next();
                      if c2 == '\n' { break; }
                  }
              }
              '=' => { tokens.push(Token::Equals { line }); chars.next(); }
              _ if is_word_char(c) => {
                  let mut text = String::new();
                  while let Some(&c2) = chars.peek() {
                      if is_word_char(c2) { text.push(c2); chars.next(); } else { break; }
                  }
                  tokens.push(Token::Word { line, text });
              }
              _ => { chars.next(); } // skip unknown? no — should be an error token?
          }
      }
      tokens
  }
  ```
  Bug: comment branch consumes '\n' without line += 1.

  Parser:
  ```rust
  pub struct Entry { pub key: String, pub value: String, pub line: usize }
  #[derive(Debug)]
  pub struct ParseError { pub line: usize, pub message: String }

  pub fn parse(src: &str) -> Result<Vec<Entry>, ParseError> {
      let tokens = lex(src);
      let mut entries = Vec::new();
      let mut i = 0;
      while i < tokens.len() {
          match &tokens[i] {
              Token::Word { line, text } => {
                  let key = text.clone(); let key_line = *line;
                  // expect '='
                  match tokens.get(i + 1) {
                      Some(Token::Equals { .. }) => {}
                      Some(Token::Word { line, .. }) => return Err(ParseError { line: *line, message: format!("expected '=', found word") }),
                      None => return Err(ParseError { line: key_line, message: "expected '=', found end of input".into() }),
                  }
                  match tokens.get(i + 2) {
                      Some(Token::Word { text, .. }) => entries.push(Entry { key, value: text.clone(), line: key_line }),
                      Some(Token::Equals { line }) => return Err(ParseError { line: *line, message: "expected value, found '='".into() }),
                      None => return Err(ParseError { line: key_line, message: "expected value, found end of input".into() }),
                  }
                  i += 3;
              }
              Token::Equals { line } => return Err(ParseError { line: *line, message: "unexpected '='".into() }),
          }
      }
      Ok(entries)
  }
  ```
