[package]
name = "slag"
version = "2.9.0"
edition = "2021"
description = "Smelt ideas, skim the bugs, forge the product."
license = "MIT"
repository = "https://github.com/sliday/slag"

[[bin]]
name = "slag"
path = "src/main.rs"

[dependencies]
anyhow = "1"
chrono = "0.4"
clap = { version = "4", features = ["derive"] }
crossterm = "0.28"
indicatif = "0.17"
ratatui = "0.29"
regex = "1"
reqwest ={ version = "0.12", features = ["rustls-tls", "json"], default-features = false }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
shell-words = "1"
similar = "2"
thiserror = "2"
tokio = { version = "1", features = ["rt-multi-thread", "macros", "process", "fs", "io-util", "time", "sync", "signal"] }

[dev-dependencies]
assert_cmd = "2"
predicates = "3"
tempfile = "3"
wiremock = "0.6"

[profile.release]
lto = true
strip = true
codegen-units = 1

# Config for 'cargo dist'
[workspace.metadata.dist]
cargo-dist-version = "0.27.0"
ci = "github"
installers = ["shell"]
targets = [
    "aarch64-apple-darwin",
    "x86_64-apple-darwin",
    "x86_64-unknown-linux-gnu",
    "aarch64-unknown-linux-gnu",
]
install-path = ["$HOME/.slag/bin/"]
install-updater = true
# Codex SYSTEM PROMPT

## DO NOT MODIFY
This instruction file must not be modified. You may edit any other files.

---

## Circuit Breaker Rules
When hitting API rate limits or usage limits, STOP retrying immediately. Never retry more than 3 times for the same error. If a rate limit or quota error occurs, write a summary of what was attempted and exit gracefully rather than looping.

## SESSION START & POST-COMPACT
When starting a new session OR after auto-compact:
1. If no `AGENTS.md` exists → run `/init` to create one
2. If `AGENTS.md` exists → read it + `AGENTS.md` + `PROCESS.md` + `LEARNED.md` (if they exist)
3. Also read `~/.Codex/AGENTS.md` for universal development standards

After compact, context is lost. Re-read project files to restore context.

---

## BEHAVIORAL RULES (ALWAYS APPLY)

### Response Style
- FORBIDDEN: Saying "You're absolutely right!" — use a fun one-sentence pop culture quote instead
- Think twice before agreeing with the user

