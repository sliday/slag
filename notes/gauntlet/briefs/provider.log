                        // flight. Back to ore for `slag resume`, and stop
                        // scheduling once this batch drains.
                        let _guard = CRUCIBLE_LOCK.lock().await;
                        let mut crucible = Crucible::load(Path::new(CRUCIBLE))?;
                        crucible.set_status(&id, Status::Ore);
                        crucible.save()?;
                        budget_stop = Some((spent, cap));
                    }
                    Ok((id, Err(e))) if e.is_deterministic_provider() => {
                        set_back_to_ore(&id).await?;
                        set.abort_all();
                        while set.join_next().await.is_some() {}
                        return Err(e);
                    }
                    Ok((id, Err(_))) => {
                        // Try resmelt. Holding the lock across the smith call
                        // stalls other anvils' heat ticks, but keeps the
                        // load-resmelt-save section atomic.
                        let _guard = CRUCIBLE_LOCK.lock().await;
                        let mut crucible = Crucible::load(Path::new(CRUCIBLE))?;
                        if let Some(ingot) = crucible.get(&id).cloned() {
                            let smith = crate::smith::make_base_smith(config, hooks);
                            let result = resmelt::resmelt_ingot(&mut crucible, &ingot, smith.as_ref()).await;
                            if let Err(e) = result.as_ref() {
                                if e.is_deterministic_provider() {
                                    crucible.set_status(&id, Status::Ore);
                                    crucible.save()?;
                                    return result;
                                }
                format!(
                    "After the session finished, slag ran `{}` and got {}:\n{}",
                    bad.cmd,
                    bad.status(),
                    repo::tail(&bad.output, OUTPUT_TAIL_LINES, OUTPUT_TAIL_BYTES)
                ),
            ));
            continue;
        }

        if job.temper {
            match judge(config, hooks, &issue, &checks[0].cmd).await {
                Ok(v) if v.fulfilled => note(hooks, &format!("warden: pass ({})", v.evidence), true),
                Ok(v) => {
                    note(hooks, &format!("warden: {}", v.gap), false);
                    failure = Some(Failure::new(
                        format!("the warden rejected the fix: {}", v.gap),
                        format!(
                            "The tests pass, but an independent reviewer rejected the fix: {}",
                            v.gap
                        ),
                    ));
                    continue;
                }
                Err(e) if e.is_deterministic_provider() => return Err(e),
                // A warden that cannot run must not sink a verified fix.
                Err(e) => note(hooks, &format!("warden could not judge the fix: {e}"), false),
            }
        }
        passed = true;
        break;
                    None => break,
                }
            }
            return Err(SlagError::ProviderApi(ProviderApiError {
                status: Some(code),
                category,
                retryable: false,
                excerpt: self.error_context(&req, category, &excerpt),
            }));
        }

        Err(SlagError::ProviderTransient(self.error_context(&req, last_category,
            &format!("gave up after {attempts_made} attempts: {last_err}"))))
    }
}

fn openai_reasoning_model(model: &str) -> bool {
    model == "o1" || model.starts_with("o1-")
        || model == "o3" || model.starts_with("o3-")
        || model == "o4" || model.starts_with("o4-")
        || model.starts_with("gpt-5")
}

fn reasoning_effort(provider: ProviderPreset, model: &str, effort: super::Effort) -> Option<&'static str> {
    match provider {
        ProviderPreset::OpenAI if openai_reasoning_model(model) && !model.starts_with("o1-preview")
        println!(
            "    {}gr:{} skill:{} proof:{}{}",
            super::fg(tui::COLD),
            ingot.grade,
            ingot.skill,
            tui::truncate(&ingot.proof, 30),
            super::reset(),
        );
    }

    for heat in 1..=ingot.max {
        // Update heat in crucible file
        let current = {
            let _guard = CRUCIBLE_LOCK.lock().await;
            let mut crucible = Crucible::load(Path::new(CRUCIBLE))?;
            crucible.increment_heat(&ingot.id);
            crucible.save()?;
            let current = crucible.get(&ingot.id).map(|i| i.heat).unwrap_or(heat);
            emit(&hooks.events, EngineEvent::HeatTick { id: ingot.id.clone(), heat: current });
            current
        };
}

impl SlagError {
    pub fn is_deterministic_provider(&self) -> bool {
        match self {
            Self::ProviderApi(error) => matches!(error.category,
                ProviderErrorCategory::Auth | ProviderErrorCategory::Billing | ProviderErrorCategory::InvalidRequest),
            Self::SurveyFailed(message) | Self::FounderFailed(message)
            | Self::SmithFailed(message) | Self::Provider(message) => {
                ["provider error: invalid key (", "provider error: credit balance low (",
                    "provider error: invalid request ("].iter().any(|prefix| message.contains(prefix))
            }
            Self::Other(error) => error.chain().any(|cause| {
                cause.downcast_ref::<SlagError>().is_some_and(Self::is_deterministic_provider)
            }),
            _ => false,
        }
    }

    /// True when retrying the same call may succeed. Permanent failures
    /// (auth, billing, malformed requests) return false.
    pub fn retryable(&self) -> bool {
        match self {
            SlagError::ProviderTransient(_) => true,
            SlagError::ProviderApi(e) => e.retryable,
            _ => false,
        }
    }
}

static PROVIDER_RUN: std::sync::Mutex<Option<Option<ProviderApiError>>> = std::sync::Mutex::new(None);

