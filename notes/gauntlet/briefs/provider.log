+    slag(&project, &config)
+        .env("SLAG_BASE_URL", server.uri())
+        .args(["--provider", "openai", "cost"])
+        .assert()
+        .success()
+        .stdout(contains("session $0.25"))
+        .stderr(contains("session spend only"));
+    assert!(server.received_requests().await.unwrap().is_empty());
+}

