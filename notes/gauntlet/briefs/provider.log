+++ b/slag-rs/tests/providers_cli.rs
@@ -0,0 +1,135 @@
+use std::time::Duration;
+
+use assert_cmd::Command;
+use predicates::str::contains;
+use tempfile::TempDir;
+
+fn slag(project: &TempDir, config: &TempDir) -> Command {
+    let mut cmd = Command::new(env!("CARGO_BIN_EXE_slag"));
+    cmd.env_clear()
+        .env("SLAG_CONFIG_DIR", config.path())
+        .env("NO_COLOR", "1")
+        .current_dir(project.path())
+        .timeout(Duration::from_secs(15));
+    cmd
+}
+
+#[test]
+fn provider_flag_overrides_env_and_file_before_or_after_key() {
+    let project = tempfile::tempdir().unwrap();
+    let config = tempfile::tempdir().unwrap();
+    std::fs::write(config.path().join("config.toml"), "provider = \"groq\"\n").unwrap();
+    for args in [["--provider", "ollama", "key"], ["key", "--provider", "ollama"]] {
+        slag(&project, &config)
+            .env("SLAG_PROVIDER", "openai")
+            .args(args)
+            .assert()
+            .success()
+            .stdout(contains("ollama"));
+    }
+    slag(&project, &config)
+        .env("SLAG_PROVIDER", "lmstudio")
+        .arg("key")
+        .assert()
+        .success()
+        .stdout(contains("lmstudio"));
+    slag(&project, &config)
+        .arg("key")
+        .assert()
+        .success()
+        .stdout(contains("groq"))
+        .stdout(contains("GROQ_API_KEY"));
+}
+
+#[test]
+fn named_keys_preserve_other_settings_and_hide_key_values() {
+    let project = tempfile::tempdir().unwrap();
+    let config = tempfile::tempdir().unwrap();
+    std::fs::write(
+        config.path().join("config.toml"),
+        "model_base = \"my-model\"\nopenrouter_api_key = \"old-router-key\"\n",
+    ).unwrap();
+    let secret = "test-secret-never-print-this-key";
+    let output = slag(&project, &config)
+        .args(["key", "--provider", "cerebras", secret])
+        .assert()
+        .success()
+        .get_output()
+        .clone();
+    assert!(!String::from_utf8_lossy(&output.stdout).contains(secret));
+    assert!(!String::from_utf8_lossy(&output.stderr).contains(secret));
+    let contents = std::fs::read_to_string(config.path().join("config.toml")).unwrap();
+    assert!(contents.contains("cerebras_api_key"));
+    assert!(contents.contains(secret));
+    assert!(contents.contains("old-router-key"));
+    assert!(contents.contains("my-model"));
+    let output = slag(&project, &config)
+        .args(["key", "--provider", "cerebras"])
+        .assert()
+        .success()
+        .get_output()
+        .clone();
+    let status = String::from_utf8_lossy(&output.stdout);
+    assert!(status.contains("cerebras"));
+    assert!(!status.contains(secret));
+    assert!(!status.contains("test-se"));
+}
+
+#[test]
+fn missing_remote_key_names_the_selected_provider() {
+    let project = tempfile::tempdir().unwrap();
+    let config = tempfile::tempdir().unwrap();
+    slag(&project, &config)
+        .args(["--provider", "cerebras", "resume"])
+        .assert()
+        .failure()
+        .stderr(contains("CEREBRAS_API_KEY"));
+}
+
+#[test]
+fn local_provider_passes_the_key_gate_without_a_key() {
+    let project = tempfile::tempdir().unwrap();
+    let config = tempfile::tempdir().unwrap();
+    let output = slag(&project, &config)
+        .args(["--provider", "ollama", "resume"])
+        .assert()
+        .failure()
+        .get_output()
+        .clone();
+    let error = String::from_utf8_lossy(&output.stderr);
+    assert!(error.contains("no PRD.md"), "{error}");
+    assert!(!error.contains("API_KEY"), "{error}");
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn non_router_cost_uses_session_spend_without_a_balance_request() {
+    use wiremock::matchers::any;
+    use wiremock::{Mock, MockServer, ResponseTemplate};
+
+    let project = tempfile::tempdir().unwrap();
+    let config = tempfile::tempdir().unwrap();
+    std::fs::create_dir(project.path().join(".slag")).unwrap();
+    std::fs::write(project.path().join(".slag/session-costs.json"), "0.25").unwrap();
+    let server = MockServer::start().await;
+    Mock::given(any())
+        .respond_with(ResponseTemplate::new(500))
+        .expect(0)
+        .mount(&server)
+        .await;
+    slag(&project, &config)
+        .env("SLAG_BASE_URL", server.uri())
+        .env("OPENAI_API_KEY", "test-key")
+        .args(["--provider", "openai", "cost"])
+        .assert()
+        .success()
+        .stdout(contains("session $0.25"))
+        .stderr(contains("session spend only"));
+    slag(&project, &config)
+        .env("SLAG_BASE_URL", server.uri())
+        .args(["--provider", "openai", "cost"])
+        .assert()
+        .success()
+        .stdout(contains("session $0.25"))
+        .stderr(contains("session spend only"));
+    assert!(server.received_requests().await.unwrap().is_empty());
+}

diff --git a/slag-rs/src/smith/native.rs b/slag-rs/src/smith/native.rs
index 5c17b5627784444bb119fed399d1429c970a5799..9e1396a6e0227abd152c6f21182fbe001ba6c74b
--- a/slag-rs/src/smith/native.rs
+++ b/slag-rs/src/smith/native.rs
@@ -336,4 +336,66 @@
         assert!(smith.hooks.steer.is_none(), "casts must not consume dashboard steers");
         assert!(smith.hooks.cancel.is_some());
     }
+
+    #[tokio::test]
+    async fn plan_and_work_roles_use_separate_providers_without_router_calls() {
+        use wiremock::matchers::{any, body_partial_json, header, method, path};
+        use wiremock::{Mock, MockServer, ResponseTemplate};
+
+        let (_guard, _dir) = crate::config::isolated_config_dir();
+        let plan = MockServer::start().await;
+        let work = MockServer::start().await;
+        let router = MockServer::start().await;
+        Mock::given(any())
+            .respond_with(ResponseTemplate::new(500))
+            .expect(0).mount(&router).await;
+        for (server, key, model, answer) in [
+            (&plan, "plan-key", "gpt-4.1-mini", "planned"),
+            (&work, "work-key", "gpt-oss-120b", "forged"),
+        ] {
+            Mock::given(method("POST"))
+                .and(path("/chat/completions"))
+                .and(header("Authorization", format!("Bearer {key}")))
+                .and(body_partial_json(serde_json::json!({"model": model})))
+                .respond_with(ResponseTemplate::new(200).set_body_json(serde_json::json!({
+                    "choices": [{"message": {"content": answer}, "finish_reason": "stop"}],
+                })))
+                .expect(1).mount(server).await;
+        }
+        let vars = [
+            ("OPENAI_API_KEY", "plan-key".to_string()),
+            ("CEREBRAS_API_KEY", "work-key".to_string()),
+            ("SLAG_OPENAI_BASE_URL", plan.uri()),
+            ("SLAG_CEREBRAS_BASE_URL", work.uri()),
+        ];
+        let previous: Vec<_> = vars.iter().map(|(name, _)| (*name, std::env::var_os(name))).collect();
+        for (name, value) in &vars {
+            std::env::set_var(name, value);
+        }
+        let mut config = cfg();
+        config.base_url = router.uri();
+        config.model_base = "cerebras::gpt-oss-120b".into();
+        config.model_plan = "openai::gpt-4.1-mini".into();
+        let hooks = EngineHooks::default();
+        let planner = NativeSmith::plan(config.clone(), PathBuf::from("."), &hooks);
+        let worker = NativeSmith::forge(config, "rust", 1, PathBuf::from("."), &hooks);
+        let planned = planner.invoke("Return planned.").await;
+        let forged = worker.invoke("Return forged.").await;
+        for (name, value) in previous {
+            match value {
+                Some(value) => std::env::set_var(name, value),
+                None => std::env::remove_var(name),
+            }
+        }
+        assert_eq!(planned.unwrap(), "planned");
+        assert_eq!(forged.unwrap(), "forged");
+        assert!(router.received_requests().await.unwrap().is_empty());
+        for server in [&plan, &work] {
+            let requests = server.received_requests().await.unwrap();
+            assert_eq!(requests.len(), 1);
+            assert!(!requests[0].headers.contains_key("HTTP-Referer"));
+            let body: serde_json::Value = serde_json::from_slice(&requests[0].body).unwrap();
+            assert!(body.get("reasoning").is_none());
+        }
+    }
 }
