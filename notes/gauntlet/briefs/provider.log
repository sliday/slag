+    for args in [["--provider", "ollama", "key"], ["key", "--provider", "ollama"]] {
+        slag(&project, &config)
+            .env("SLAG_PROVIDER", "openai")
+            .args(args)
+            .assert()
+            .success()
+            .stdout(contains("ollama"));
+    }
+    slag(&project, &config)
+        .env("SLAG_PROVIDER", "lmstudio")
+        .arg("key")
+        .assert()
+        .success()
+        .stdout(contains("lmstudio"));
+    slag(&project, &config)
+        .arg("key")
+        .assert()
+        .success()
+        .stdout(contains("groq"))
+        .stdout(contains("GROQ_API_KEY"));
+}
+
