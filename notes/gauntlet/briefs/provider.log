    }

    #[cfg(test)]
    fn with_timeout(mut self, timeout: Duration) -> Self {
        self.timeout = timeout;
        self.http = std::sync::Mutex::new(build_client(timeout, false));
        self
    }

    /// Pin the fallback (tests must not depend on ambient env).
