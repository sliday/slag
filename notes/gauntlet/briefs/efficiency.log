import csv
import json
import sys
import argparse


def main():
    parser = argparse.ArgumentParser(description="Convert CSV to JSON.")
    parser.add_argument('csvfile', type=argparse.FileType('r'), help='Input CSV file')
    parser.add_argument('--pretty', action='store_true', help='Pretty-print JSON output')
    args = parser.parse_args()

    reader = csv.DictReader(args.csvfile)
    rows = list(reader)

    if args.pretty:
        print(json.dumps(rows, indent=4))
    else:
        print(json.dumps(rows))


if __name__ == '__main__':
    main()
import unittest
import subprocess
import sys
import os
import json

class TestCsvToJsonCLI(unittest.TestCase):
    def setUp(self):
        self.csv_content = """name,age\nAlice,30\nBob,25\n"""
        self.csv_file = 'test.csv'
        with open(self.csv_file, 'w') as f:
            f.write(self.csv_content)

    def tearDown(self):
        try:
            os.remove(self.csv_file)
        except FileNotFoundError:
            pass

    def run_cli(self, args):
        result = subprocess.run([sys.executable, '-m', 'csvtojson.cli'] + args,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        return result

    def test_simple_conversion(self):
        result = self.run_cli([self.csv_file])
        self.assertEqual(result.returncode, 0)
        # Check output is a JSON list
        data = json.loads(result.stdout)
        self.assertIsInstance(data, list)
        self.assertEqual(len(data), 2)
        self.assertEqual(data[0]['name'], 'Alice')

    def test_pretty_flag(self):
        result = self.run_cli([self.csv_file, '--pretty'])
        self.assertEqual(result.returncode, 0)
        # Output should be pretty-printed JSON with newlines
        self.assertIn('\n    ', result.stdout)

    def test_file_not_found(self):
        result = self.run_cli(['nonexistent.csv'])
        self.assertNotEqual(result.returncode, 0)
        self.assertIn('No such file or directory', result.stderr)

