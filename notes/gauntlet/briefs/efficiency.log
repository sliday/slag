    pub fn with_context_window(mut self, window_tokens: Option<u64>) -> Self {
        if env_token_budget().is_none() {
            if let Some(window) = window_tokens {
                self.token_budget = budget_for_window(window).min(DEFAULT_TOKEN_BUDGET);
            }
        }
        self
