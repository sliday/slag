class TestWc(unittest.TestCase):
    def test_count_lines(self):
        self.assertEqual(count_lines(''), 0)
        self.assertEqual(count_lines('one\n'), 1)
        self.assertEqual(count_lines('a\nb\nc\n'), 3)
        self.assertEqual(count_lines('a\nb\nc'), 3)

    def test_count_words(self):
        self.assertEqual(count_words(''), 0)
        self.assertEqual(count_words('one'), 1)
        self.assertEqual(count_words('two words here'), 3)
import argparse
import csv
import json
import sys

def convert_csv_to_json(input_path, output_path, pretty):
    with open(input_path, newline='', encoding='utf-8') as input_file:
        reader = csv.DictReader(input_file)
        data = list(reader)

    if output_path == '/dev/stdout':
        output_stream = sys.stdout
    else:
        output_stream = open(output_path, 'w', encoding='utf-8')

    if pretty:
        json.dump(data, output_stream, indent=4)
    else:
        json.dump(data, output_stream)

    if output_path != '/dev/stdout':
        output_stream.close()

def main():
    parser = argparse.ArgumentParser(description='CSV to JSON converter')
    parser.add_argument('--input', required=True, help='Input CSV file path')
    parser.add_argument('--output', required=True, help='Output JSON file path or /dev/stdout')
    parser.add_argument('--pretty', action='store_true', help='Pretty print JSON output')

    args = parser.parse_args()
    convert_csv_to_json(args.input, args.output, args.pretty)


if __name__ == '__main__':
    main()
