        if body.lines().any(|line| line.trim() == pattern) { continue; }
        if !body.is_empty() && !body.ends_with('\n') { body.push('\n'); }
        body.push_str(pattern);
        body.push('\n');
    }
    if body.len() != original_len {
        std::fs::create_dir_all(parent)?;
        require_regular_ignore(&path)?;
        std::fs::write(path, body)?;
    }
    Ok(())
}

fn require_regular_ignore(path: &Path) -> io::Result<()> {
    match std::fs::symlink_metadata(path) {
        Ok(metadata) if metadata.is_file() => Ok(()),
        Ok(_) => Err(io::Error::new(
            io::ErrorKind::PermissionDenied,
            "cannot update a symlink or nonregular .gitignore",
        )),
        Err(e) if e.kind() == io::ErrorKind::NotFound => Ok(()),
        Err(e) => Err(e),
    }
}

fn detect_stacks(
    root: &Path,
    depth: usize,
    budget: &mut usize,
    stacks: &mut [bool; 3],
) -> io::Result<()> {
    for entry in std::fs::read_dir(root)? {
        if *budget == 0 {
            break;
        }
        *budget -= 1;
        let entry = entry?;
        let kind = entry.file_type()?;
        let path = entry.path();
        let name = entry.file_name();
        let name = name.to_string_lossy();
        if kind.is_file() {
            match name.as_ref() {
                "pyproject.toml" | "requirements.txt" | "setup.py" | "Pipfile" => stacks[0] = true,
                "package.json" | "package-lock.json" | "pnpm-lock.yaml" | "yarn.lock" => {
                    stacks[1] = true
                }

