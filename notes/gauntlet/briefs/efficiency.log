+    "PLAN.md", "PROGRESS.md", "BLUEPRINT.md", "BAR.md", "PRD.md", "AGENTS.md",
+];
+
+pub(crate) struct CoordinatorGuard {
+    files: Vec<(std::path::PathBuf, Option<Vec<u8>>)>,
+}
+
+impl CoordinatorGuard {
+    pub(crate) fn capture(root: &std::path::Path) -> std::io::Result<Self> {
+        let mut files = Vec::new();
+        for name in COORDINATOR_FILES {
+            let path = root.join(name);
+            let body = match std::fs::read(&path) {
+                Ok(body) => Some(body),
+                Err(e) if e.kind() == std::io::ErrorKind::NotFound => None,
+                Err(e) => return Err(e),
+            };
+            files.push((path, body));
+        }
+        Ok(Self { files })
+    }
+
+    pub(crate) fn restore(&self) -> std::io::Result<Vec<String>> {
+        let mut changed = Vec::new();
+        for (path, body) in &self.files {
+            let metadata = std::fs::symlink_metadata(path).ok();
+            let current = std::fs::read(path).ok();
+            if current == *body && metadata.as_ref().is_none_or(|m| m.is_file()) {
+                continue;
+            }
+            if metadata.as_ref().is_some_and(|m| m.is_dir()) {
+                std::fs::remove_dir_all(path)?;
+            } else if metadata.is_some() {
+                std::fs::remove_file(path)?;
+            }
+            match body {
+                Some(body) => std::fs::write(path, body)?,
+                None => {}
+            }
+            changed.push(path.file_name().unwrap().to_string_lossy().into_owned());
+        }
+        Ok(changed)
+    }
+}
