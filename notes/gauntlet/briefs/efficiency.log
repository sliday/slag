    }
    let original_len = body.len();
    for pattern in patterns {
        if body
            .lines()
            .any(|line| line.trim() == pattern)
        {
            continue;
        }
        if !body.is_empty() && !body.ends_with('\n') {
            body.push('\n');
        }
        body.push_str(pattern);
        body.push('\n');
    }
    if body.len() != original_len {
        require_regular_ignore(&path)?;
        std::fs::write(path, body)?;
    }
    Ok(())
}

fn install_local_ignores(root: &Path) -> io::Result<()> {
    let output = crate::engine::sandbox::git()
        .args(["rev-parse", "--git-path", "info/exclude"])
        .current_dir(root)
        .output()?;
    if !output.status.success() {
        if String::from_utf8_lossy(&output.stderr).contains("not a git repository") {
            return Ok(());
        }
        return Err(io::Error::other(String::from_utf8_lossy(&output.stderr)));
    }
    let relative = String::from_utf8(output.stdout).map_err(io::Error::other)?;
    let path = root.join(relative.trim());
    let root = root.canonicalize()?;
    let parent = path
        .parent()
        .ok_or_else(|| io::Error::other("exclude has no parent"))?;
    let mut ancestor = parent;
    while !ancestor.exists() {
        ancestor = ancestor
            .parent()
            .ok_or_else(|| io::Error::other("exclude has no existing parent"))?;
    }
    if !ancestor.canonicalize()?.starts_with(&root) {
        let existing = std::fs::read_to_string(&path).unwrap_or_default();
        if ["/.slag/", "/logs/"]
            .iter()
            .all(|pattern| existing.lines().any(|line| line.trim() == *pattern))
        {
            return Ok(());
        }
        return Err(io::Error::new(
            io::ErrorKind::PermissionDenied,
            "local excludes leave the workspace",
        ));
    }
    for part in parent.strip_prefix(&root).unwrap_or(parent).components() {
        if matches!(part, Component::ParentDir) {
            return Err(io::Error::new(
                io::ErrorKind::PermissionDenied,
                "local excludes leave the workspace",
            ));
        }
    }
    require_regular_ignore(&path)?;
    let mut body = match std::fs::read_to_string(&path) {
        Ok(body) => body,
        Err(e) if e.kind() == io::ErrorKind::NotFound => String::new(),
        Err(e) => return Err(e),
    };
    let original_len = body.len();
    for pattern in ["/.slag/", "/logs/"] {
        if body.lines().any(|line| line.trim() == pattern) {
            continue;
        }
        if !body.is_empty() && !body.ends_with('\n') {
        commands = commands.iter().map(|command| environment(command)).collect();
    }
    Some(DirectPlan { proof: proof.to_string(), criteria, commands, fixtures: reference.fixtures })
}

fn python_commission(commission: &str) -> bool {
    let lower = commission.to_ascii_lowercase();
    ["python", "unittest", ".py"].iter().any(|word| lower.contains(word))
}

fn conventional_criteria(commission: &str, cli: bool, package: bool) -> Vec<&'static str> {
    if !cli { return Vec::new(); }
    let lower = commission.to_ascii_lowercase();
    let mut criteria = Vec::new();
    if package && python_commission(commission) {
        criteria.push("Provide a console-script entry point and __main__.py for python3 -m PACKAGE. Install in a local virtual environment before review. Document and run both launch methods. The suite must pass from a fresh clone without installation.");
    }
    if lower.contains("node") {
        criteria.push("Provide package.json with a bin entry that points to the runnable CLI. Document and verify that entry.");
    }
    if ["file", "text", "csv", "like "].iter().any(|word| lower.contains(word)) {
        criteria.push("Read stdin when no input file is given or the input file is literal -. Document both interfaces and --help. Run stdin, dash, and help probes. Test their results through the real CLI.");
    }
    if lower.contains("top n") || lower.contains("top-n") {
        criteria.push("Choose and document a sensible default N. Accept FILE N positionally and N through a flag. Verify the default, positional, and flag forms through CLI tests.");
    }
    criteria
}

fn write_redirection(command: &str) -> bool {
    let mut quote = None;
    let mut escaped = false;
    let mut chars = command.chars().peekable();
    while let Some(c) = chars.next() {
        if escaped { escaped = false; continue }
        if c == '\\' && quote != Some('\'') { escaped = true; continue }
        if quote == Some(c) { quote = None; continue }
        if quote.is_none() {
            if matches!(c, '\'' | '"') { quote = Some(c); }
            else if c == '>' {
                if chars.peek().is_some_and(|next| matches!(*next, '>' | '|' | '&')) { return true }

