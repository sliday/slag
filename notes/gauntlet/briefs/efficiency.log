fn scope_json(raw: &str) -> Option<&str> {
    if raw.len() > 8_192 { return None }
    let raw = raw.trim();
    if let Some(body) = raw.strip_prefix("```json\n").or_else(|| raw.strip_prefix("```json\r\n")) {
        body.strip_suffix("\n```").map(str::trim)
    } else {
        Some(raw)
    }
}

