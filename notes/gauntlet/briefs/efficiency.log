"""wc.py: count words in a file."""

import sys


def count_words(text):
    """Return the number of whitespace-separated words in text."""
    return len(text.split())


def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]
    if not argv:
        print("usage: wc.py FILE", file=sys.stderr)
        return 1
    try:
        with open(argv[0], encoding="utf-8") as f:
            text = f.read()
    except OSError as exc:
        print("wc.py: %s: %s" % (argv[0], exc.strerror), file=sys.stderr)
        return 1
    print(count_words(text))
    return 0


if __name__ == "__main__":
    sys.exit(main())"""Unit tests for wc.py."""

import os
import sys
import tempfile
import unittest

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import wc


class CountWordsTest(unittest.TestCase):
    def test_simple(self):
        self.assertEqual(wc.count_words("one two three"), 3)

    def test_mixed_whitespace(self):
        self.assertEqual(wc.count_words("a\n  b\tc"), 3)

    def test_empty(self):
        self.assertEqual(wc.count_words(""), 0)


class MainTest(unittest.TestCase):
    def test_counts_words_in_file(self):
        fd, name = tempfile.mkstemp(suffix=".txt")
        try:
            with os.fdopen(fd, "w") as f:
                f.write("hello world\nsecond line\n")
            rc = wc.main([name])
            self.assertEqual(rc, 0)
        finally:
            os.unlink(name)

    def test_no_args(self):
        self.assertEqual(wc.main([]), 1)

    def test_missing_file(self):
        self.assertEqual(wc.main(["/nonexistent/path/file.txt"]), 1)


if __name__ == "__main__":
    unittest.main()
