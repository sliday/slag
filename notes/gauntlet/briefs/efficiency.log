#!/bin/bash
# Script to create a virtual environment and install the greet package inside it

set -e

# Check if .venv directory exists
if [ ! -d ".venv" ]; then
  echo ".venv directory not found. Creating virtual environment..."
  python3 -m venv .venv
else
  echo ".venv directory already exists. Using existing virtual environment."
fi

# Activate the virtual environment
source .venv/bin/activate

# Upgrade pip
pip install --upgrade pip

# Install the greet package
pip install .

# Confirm install worked
pip list | grep greet

echo "greet package installed in .venv virtual environment."# Smithy Ledger

