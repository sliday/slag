+        Ok(changed) if changed.is_empty() => (ok, output),
+        Ok(changed) => (false, format!("verification changed coordinator files: {}\n{output}", changed.join(", "))),
+        Err(e) => (false, format!("cannot restore coordinator files: {e}\n{output}")),
+    }
