 succeeded in 0ms:
        }
    }

    /// The report card. The verdict comes first and is the only claim on
    /// it: no bar, since a full bar over a failed goal reads as success.
    /// Then why and what to do next, then the evidence: what ran and how
    /// it exited, what git says changed, where the work is, what it cost.
    fn assay(&mut self, at: Instant, out: &mut Vec<String>) {
        self.assay_done = true;
        self.phase = Phase::Assay;
        let counts = self.counts();
        let stats = self.stats.clone().unwrap_or_default();
        let w = self.width;
        out.push(String::new());
        out.push(tui::rule_line("ASSAY", &tui::clock(self.elapsed(at)), w));

        // The verdict: one word, one clause.
        let left = counts.ore + counts.molten;
        let (glyph, color, word, says) = if counts.cracked > 0 {
            let n = counts.cracked;
            ("✗", WARM, "CRACKED", format!("{n} of {} ingots failed every heat; {} forged", counts.total, counts.forged))
        } else if self.goal_gap.is_some() {
            ("✗", WARM, "GOAL NOT MET", "every task passed its proof; the warden rejected the result".to_string())
        } else if left > 0 {
            ("!", BRIGHT, "PAUSED", format!("{} of {} forged; {left} still queued", counts.forged, counts.total))
        } else if self.goal_met {
            ("█", PURE, "FORGED", format!("all {} ingots passed their proofs; the warden accepted the goal", counts.total))
        } else {
            ("█", PURE, "FORGED", format!("all {} ingots passed their proofs", counts.total))
        };
        let head = format!("  {} {}  ", paint(color, glyph), paint(color, &format!("{}{word}{}", bold_on(), bold_off())));
        let room = w.saturating_sub(tui::visible_len(&head));
        out.push(format!("{head}{}", tui::clip(&says, room)));

        // Why, when it failed: the gap, or each cracked ingot's last reason.
        if let Some(gap) = &self.goal_gap {
            out.extend(wrap_indented(gap, w, 4, 3).into_iter().map(|l| paint(WARM, &l)));
        }
        let cracked: Vec<&Ingot> = self.plan.iter().filter(|i| i.status == Status::Cracked).collect();
        for ingot in &cracked {
            let why = self
                .proofs
                .get(&ingot.id)
                .and_then(|p| p.why.clone())
                .unwrap_or_else(|| "every heat failed its proof".to_string());
            let name = tui::clip(&title(&ingot.work), (w / 3).max(12));
    echo.finish(now)
}

/// `warden round 2: no tests cover the CLI` → `no tests cover the CLI`.
pub fn warden_word(msg: &str) -> Option<&str> {
    let rest = msg.strip_prefix("warden round ")?;
    rest.split_once(": ").map(|(_, w)| w)
}

/// What an ingot is, not how the founder labelled it: plans open every
/// `:work` with `Goal:` or `TASK:`, which is boilerplate once it is on
/// every row.
pub fn title(work: &str) -> String {
    let work = unescape(work);
    let mut t = work.trim();
    for label in ["GOAL:", "TASK:", "INGOT:", "WORK:"] {
        let content = std::fs::read_to_string(crucible_path).unwrap_or_default();
        !content.contains("(ingot ")
    };
    if needs_founder {
        let smith = crate::smith::make_plan_smith(config, &hooks, crate::engine::Role::Founder);
        founder::run(smith.as_ref()).await?;
        // Same question one level down: forged, do these ingots add up to
        // the commission? A missing capability costs nothing to fix here
        // and a full forge to fix later.
        if let Some(gap) = checkpoint(config, &hooks, "PLAN", crate::config::CRUCIBLE).await {
            founder::run_with_guidance(smith.as_ref(), Some(&gap)).await?;
        }
    } else if ore == Ore::Extended {
        let smith = crate::smith::make_plan_smith(config, &hooks, crate::engine::Role::Founder);
        let added = founder::extend(smith.as_ref()).await?;
        if added == 0 {
            // The model read the addendum and found nothing to build.
            // Saying so beats a silent finish that looks like a no-op.
            // It rides the event stream rather than stdout: a bare
            // `println!` under --tui writes into the alternate screen and
            // lands glued to whatever row is being drawn.
            crate::engine::emit(
                &hooks.events,
                crate::engine::EngineEvent::Warning {
                    message: "the addendum cast no ingots — nothing in it needs building"
                        .to_string(),
                },
            );
        }
    }

    if let Some((_, gap)) = &resumed_gap {
        let crucible = Crucible::load(crucible_path)?;
        if !crucible.has_pending() && crucible.counts().cracked == 0 {
            fire_furnace(Some(gap))?;
            let smith = crate::smith::make_plan_smith(config, &hooks, crate::engine::Role::Founder);
            if founder::extend(smith.as_ref()).await? == 0 {
                return Err(SlagError::GoalNotMet(format!(
                    "{gap}; the founder cast no repair ingots"
                )));
            }
        }
    }

    // Phase 3: Forge, and Phase 4: Temper.
    //
    // The forge proves tasks; `:proof` answers "did this artifact appear".
    // Nothing proved the *goal*, and the summary that claimed it was written
    // by the smith that did the work. The warden closes that: a critic that
    // built nothing opens the real artifact, compares it with the bar, and
    // on a loss names one gap. The gap becomes an addendum, the addendum
    let entry = format!(
        "\n## {} [{}] gr:{} skill:{}\n- {}\n- heats:{}\n",
        chrono::Local::now().format("%m-%d %H:%M"),
        ingot.id,
        ingot.grade,
        ingot.skill,
        ingot.work,
        heat,
    );
    let _ = std::fs::OpenOptions::new()
        .create(true)
        .append(true)
        .open(LEDGER)
        .and_then(|mut f| {
            use std::io::Write;
            f.write_all(entry.as_bytes())
        });
}

fn log_to_file(label: &str, content: &str) {
    let ts = chrono::Local::now().format("%Y%m%d_%H%M%S");
    let path = format!("{}/{ts}_{label}.log", crate::config::LOG_DIR);
    let _ = std::fs::write(&path, content);
}

