+        std::fs::create_dir(dir.path().join("logs")).unwrap();
+        std::fs::write(dir.path().join(".gitignore"), "logs/\n").unwrap();
+        assert!(empty_project(dir.path()));
+        std::fs::write(dir.path().join("existing.py"), "print(1)\n").unwrap();
+        assert!(!empty_project(dir.path()));
