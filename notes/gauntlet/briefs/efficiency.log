import sys
import argparse


def count_lines(text):
    if not text:
        return 0
    # Handles cases where lines end without a newline
    lines = text.count('\n')
    if not text.endswith('\n'):
        lines += 1
    return lines


def count_words(text):
    # Split on whitespace but treat consecutive whitespace as one
    # Match Unix wc behavior which counts words separated by whitespace
    if not text:
        return 0
    return len(text.split())


def count_bytes(text):
    return len(text.encode('utf-8'))


def parse_args():
    parser = argparse.ArgumentParser(description='Count lines, words, and bytes of a file')
    parser.add_argument('filename', type=str, help='Input file to count')
    return parser.parse_args()


def main():
    args = parse_args()

    try:
        with open(args.filename, 'rb') as f:
            data_bytes = f.read()
    except Exception as e:
        print(f"error: cannot open file '{args.filename}'", file=sys.stderr)
        sys.exit(1)

    data_str = data_bytes.decode('utf-8', errors='replace')

    lines = count_lines(data_str)
    words = count_words(data_str)
    bytes_count = len(data_bytes)

    print(f"{lines} {words} {bytes_count} {args.filename}")
    sys.exit(0)


if __name__ == '__main__':
    main()


