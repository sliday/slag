# wc

Run `python3 -B wc.py FILE` to print newline, word, and byte counts followed
by the filename. Without FILE, input comes from stdin and no filename is printed.
Lines count newline bytes, including no extra line for an unterminated record.
Words are whitespace-delimited using the current locale's text encoding; byte
counts include every input byte, not just decoded characters.

Usage: `python3 -B wc.py --help`.
Example: `python3 -B wc.py fixtures/sample.txt`.

Run tests without writing bytecode caches:
`PYTHONDONTWRITEBYTECODE=1 python3 -m unittest`.
The suite uses existing fixtures and in-memory stdin, including comparisons with
system `wc`; no fixture or temporary-file writes are needed.
#!/usr/bin/env node
'use strict';

const fs = require('node:fs');

const help = `Usage: node cli.js [--top N] [file]

Print the most frequent words and their counts, one word per line.
Read stdin when no file is supplied.

Options:
  --top N   Show at most N words (positive integer; default: 10)
  --help    Show this help

Words are case-insensitive Unicode letter/number sequences.
Output is "word count"; ties are sorted by word in code-point order.
Use -- before a file name that starts with a dash.
`;

function main() {
  const args = process.argv.slice(2);
  let top = 10;
  let file;
  let positionalOnly = false;
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (!positionalOnly && arg === '--help') {
      process.stdout.write(help);
      return;
    }
    if (!positionalOnly && arg === '--') {
      positionalOnly = true;
    } else if (!positionalOnly && arg === '--top') {
      const value = args[++i];
      if (!/^[1-9]\d*$/.test(value || '') || !Number.isSafeInteger(Number(value))) {
        throw new Error('--top requires a positive safe integer');
      }
      top = Number(value);
    } else if (!positionalOnly && arg.startsWith('-')) {
      throw new Error(`Unknown option: ${arg}`);
    } else if (file !== undefined) {
      throw new Error('Expected at most one input file');
    } else {
      file = arg;
    }

