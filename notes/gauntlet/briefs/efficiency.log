import sys


def count_file(path):
    lines = 0
    words = 0
    bytes_ = 0
    with open(path, 'rb') as f:
        for line in f:
            lines += 1
            bytes_ += len(line)
            # decode line for word count
            try:
                text_line = line.decode('utf-8')
            except UnicodeDecodeError:
                text_line = line.decode('latin1')
            words += len(text_line.split())
    return lines, words, bytes_


def main():
    if len(sys.argv) != 2:
        print(f"Usage: {sys.argv[0]} FILE", file=sys.stderr)
        sys.exit(1)
    path = sys.argv[1]
    lines, words, bytes_ = count_file(path)
    print(f"{lines} {words} {bytes_} {path}")


if __name__ == '__main__':
    main()

