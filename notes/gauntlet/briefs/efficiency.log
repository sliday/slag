/// The warden's brief: inspect the real artifact, compare it with the bar,
/// and report a structured verdict.
///
/// It is told nothing about how the work was done. A critic handed the
/// builder's account grades the account.
pub fn warden_prompt(ore: &str, bar: &str) -> String {
    format!(
        "ROLE: independent reviewer. You did NOT build this and you owe its \
         author nothing.\n\n\
         THE GOAL:\n{ore}\n\n\
         THE BAR:\n{bar}\n\n\
         Inspect the source and tests on disk.\n\
         Run the declared test suite and CLI probes under the read-only sandbox.\n\
         Run each required check in its own bash call. Known test output flags may differ. Preserve the program, suite selection, and CLI arguments. Cite those successful runs in EVIDENCE.\n\
         Inspect the tests to confirm that they exercise the named behaviors and flags through the real CLI.\n\
         Python skips bytecode writes. Committed fixtures and in-memory inputs need no writes.\n\
         The review filesystem stays read-only, including temporary directories. Never install packages or create fixtures.\n\
         Return VERDICT: unverified if confinement prevents a required check. Do not treat that limit as an artifact defect.\n\
         For visual or interactive work, inspect the interface.\n\
         Batch independent inspections into one tool turn. Use at most six tool turns, then return your verdict as text.\n\
         Do not edit files. Do not install packages. Do not run git commands.\n\
         Judge the commission's stated requirements. Treat the commission as authoritative if the bar adds constraints.\n\
         {DELIVERY_RULES}\n\
         Add no features, test counts, naming rules, or bans on normal project imports.\n\
         Ignore PLAN.md, PROGRESS.md, BLUEPRINT.md, BAR.md, PRD.md, AGENTS.md, logs/, and generated caches for cleanliness.\n\
         Name one unmet requirement if the artifact fails. Cite the command output or source that proves your verdict.\n\
         Return unverified if you cannot inspect the artifact or verify a required behavior.\n\n\
         Tool results include their tool-call IDs. Cite only IDs from successful inspection results.\n\
         Put a JSON array of these IDs in EVIDENCE. Do not put paths, commands, or prose in EVIDENCE.\n\n\
         Report EXACTLY these three lines, last, and nothing after them:\n\
            t.starts_with("- [") || t.starts_with("- ") || t.starts_with("* ")
        });
    lines >= 3 && has_items
}

/// Judge the built artifact against the bar.
///
/// The warden reads source and runs checks with a bounded inspection budget.
/// It receives the goal and bar without the builder's account of the work.
pub async fn judge_artifact(
    cfg: &EngineConfig,
    hooks: &EngineHooks,
    round: usize,
) -> Result<Verdict, SlagError> {
    let ore = std::fs::read_to_string(ORE_FILE).map_err(|_| SlagError::NoOre)?;
    let bar = match bar(cfg, hooks).await {
        Ok(bar) => bar,
        Err(e) => {
            record(round, &Verdict::unverified(format!("the warden could not establish the acceptance bar: {e}")));
            return Err(e);
        }
    };

    tui::header(&format!("WARDEN · round {round}"));
    let smith = crate::smith::make_warden(cfg, hooks);
    let commands = artifact_commands(&bar);
    let prompt = format!("REQUIRED RUN COMMANDS: {}\n\n{}\n\n{}",
        serde_json::to_string(&commands).unwrap(), workspace_context(), crate::flux::warden_prompt(&ore, &bar));
    let raw = match smith
        .invoke(&prompt)
        .await
    {
        Ok(raw) => raw,
        Err(e) => {
            let verdict = Verdict::unverified(format!("the warden could not inspect the artifact: {e}"));
            record(round, &verdict);
            if e.is_deterministic_provider() {
                return Err(e);
            }
            return Ok(verdict);
        }
    };
    let verdict = parse_verdict(&raw);
    if verdict.is_unverified() { log_raw(&raw); }
    record(round, &verdict);
    Ok(verdict)
}

fn artifact_commands(bar: &str) -> Vec<String> {
    if let Some(commands) = bar.lines().find_map(|line| line.strip_prefix("REQUIRED RUN COMMANDS: ")
        .and_then(|json| serde_json::from_str::<Vec<String>>(json).ok()))
    {
        return commands;
    }
    crate::crucible::Crucible::load(std::path::Path::new(crate::config::CRUCIBLE))
        .map(|plan| plan.ingots.into_iter().filter(|ingot| ingot.status == crate::sexp::Status::Forged)
            .map(|ingot| ingot.proof).filter(|proof| !proof.is_empty() && proof != "true").collect())
        .unwrap_or_default()
}

fn log_raw(raw: &str) {
    let path = std::path::Path::new(crate::config::LOG_DIR).join(format!(
        "warden-raw-{}-{}.log", chrono::Local::now().format("%Y%m%d%H%M%S%f"), std::process::id()
    ));
    let _ = std::fs::write(path, raw);
}

