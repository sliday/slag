+        .filter(|i| !other_ids.contains(&i.id)).collect();
+    let _guard = CRUCIBLE_LOCK.lock().await;
+    let mut current = Crucible::load(Path::new(CRUCIBLE))?;
+    current.replace(&ingot.id, replacements);
+    current.save()?;
+    Ok(())
+}
