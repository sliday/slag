# Local utility

write wc.py that counts lines, words and bytes of a file like wc, with a unittest suite

## CHECKLIST
- [ ] Given a file path, wc.py outputs the correct line, word, and byte counts, matching wc behavior.
- [ ] The CLI command is wc.py, which counts lines, words, and bytes of a file like wc.
- [ ] The unittest suite is implemented using Python's unittest framework and covers wc.py functionality.
- [ ] Running python3 -m unittest runs all tests without filters or skips and does not require fixture writing.
- [ ] wc.py has at most four product files, is a local utility, and uses no external services, UI, deployment, or architectural research.
- [ ] Test cases use only in-memory data or committed fixtures and require no writes or installs.

REQUIRED RUN COMMANDS: ["python3 -m unittest discover","python3 wc.py fixtures/sample.txt","python3 wc.py -l fixtures/sample.txt","python3 wc.py -w fixtures/sample.txt","python3 wc.py -c fixtures/sample.txt"]
import test from 'node:test';
import assert from 'node:assert';
import { spawnSync } from 'node:child_process';
import path from 'path';

const cliPath = path.resolve('./cli.js');
const fixturesPath = path.resolve('./fixtures/sample.txt');

// Helper to run the CLI with args and capture stdout
function runCLI(args = []) {
  const result = spawnSync('node', [cliPath, ...args], { encoding: 'utf8' });
  return result;
}

test('prints all words and frequencies if no N specified', () => {
  const result = runCLI([fixturesPath]);
  assert.strictEqual(result.status, 0);
  // Snapshot: check top few words and counts
  const output = result.stdout.trim().split('\n');
  assert(output.length > 0);
  assert(output[0].match(/^\w+ \d+$/));
});

test('prints top 5 words using number argument', () => {
  const result = runCLI([fixturesPath, '5']);
  assert.strictEqual(result.status, 0);
  const output = result.stdout.trim().split('\n');
  assert(output.length <= 5);
  assert(output.every(line => /^\w+ \d+$/.test(line)));
});

test('prints top 10 words using --top=10', () => {
  const result = runCLI([fixturesPath, '--top=10']);
  assert.strictEqual(result.status, 0);
  const output = result.stdout.trim().split('\n');
  assert(output.length <= 10);
  assert(output.every(line => /^\w+ \d+$/.test(line)));
});

// Test invalid file path

test('invalid file path returns error', () => {
  const result = runCLI(['nonexistent.txt']);
  assert.notStrictEqual(result.status, 0);
  assert(result.stderr.includes('File not found'));
});

// Test usage error

test('no file path shows usage and error', () => {
  const result = spawnSync('node', [cliPath], { encoding: 'utf8' });
  assert.notStrictEqual(result.status, 0);
  assert(result.stderr.includes('Usage'));
});
