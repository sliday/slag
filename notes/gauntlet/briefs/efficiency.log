+fn empty_project(root: &std::path::Path) -> bool {
+    let Ok(entries) = std::fs::read_dir(root) else { return false };
+    entries.filter_map(Result::ok).all(|entry| {
+        matches!(entry.file_name().to_str(), Some(".git" | ".gitignore" | "logs"))
+    })
+}
