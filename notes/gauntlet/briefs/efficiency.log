import unittest
import os
import tempfile
import wc

class TestWC(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.NamedTemporaryFile(delete=False)

    def tearDown(self):
        try:
            os.remove(self.tmp.name)
        except OSError:
            pass

    def write_content(self, content):
        self.tmp.close()
        with open(self.tmp.name, 'wb') as f:
            f.write(content)

    def test_empty_file(self):
        self.write_content(b"")
        lines, words, bytes_ = wc.count_file(self.tmp.name)
        self.assertEqual(lines, 0)
        self.assertEqual(words, 0)
        self.assertEqual(bytes_, 0)

    def test_only_newlines(self):
        self.write_content(b"\n\n\n")
        lines, words, bytes_ = wc.count_file(self.tmp.name)
        self.assertEqual(lines, 3)
        self.assertEqual(words, 0)
        self.assertEqual(bytes_, 3)

    def test_words_and_lines(self):
        self.write_content(b"hello world\nthis is a test\n")
        lines, words, bytes_ = wc.count_file(self.tmp.name)
        self.assertEqual(lines, 2)
        self.assertEqual(words, 6)
        self.assertEqual(bytes_, len(b"hello world\nthis is a test\n"))

    def test_bytes(self):
        data = "a\u00e9\nc".encode('utf-8')  # 4 bytes, 2 lines, 2 words
        self.write_content(data)
        lines, words, bytes_ = wc.count_file(self.tmp.name)
        self.assertEqual(lines, 2)
        self.assertEqual(words, 2)
        self.assertEqual(bytes_, 5)

    def test_multiple_spaces(self):
        self.write_content(b"hello   world\n \n")
        lines, words, bytes_ = wc.count_file(self.tmp.name)
        self.assertEqual(lines, 2)
        self.assertEqual(words, 2)
        self.assertEqual(bytes_, len(b"hello   world\n \n"))

    def test_main_usage(self):
        # Should print usage and exit code 1 if no arg
        from subprocess import Popen, PIPE
        proc = Popen(['python3', 'wc.py'], stdout=PIPE, stderr=PIPE)
        out, err = proc.communicate()
        self.assertNotEqual(proc.returncode, 0)
        self.assertIn(b'Usage', err)
