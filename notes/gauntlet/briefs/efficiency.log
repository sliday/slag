diff --git a/slag-rs/src/pipeline/mod.rs b/slag-rs/src/pipeline/mod.rs
index 9602ce96ac3f18dab1c91ebb27338c2961addc8a..ac40009435ee9e3025e487736faf831b58ee0c44
--- a/slag-rs/src/pipeline/mod.rs
