fn recovery_tail(path: &std::path::Path, before: &[u8], current: &[u8]) -> Vec<u8> {
    if let Some(suffix) = current.strip_prefix(before) { return suffix.to_vec(); }
    let mut tail = Vec::new();
    for line in current.split_inclusive(|b| *b == b'\n') {
        if (line.iter().all(u8::is_ascii_whitespace) || runtime_json_line(path, line))
            && !before.split_inclusive(|b| *b == b'\n').any(|old| old == line)
        {
            tail.extend_from_slice(line);
        }
    }
    tail
}

fn runtime_json_line(path: &std::path::Path, line: &[u8]) -> bool {
    let Ok(value) = serde_json::from_slice::<serde_json::Value>(line) else { return false };
    let name = path.file_name().unwrap_or_default().to_string_lossy();
    if path.starts_with("transcripts") {
        serde_json::from_value::<crate::engine::transcript::Entry>(value).is_ok()
    } else if path.starts_with("checkpoints") && path.extension().is_some_and(|e| e == "jsonl") {
        serde_json::from_value::<crate::anvil::checkpoint::BackupEntry>(value).is_ok()
    } else if name.starts_with("run-") {
        serde_json::from_value::<crate::engine::events::RunEntry>(value).is_ok()
    } else if name.starts_with("engine-") {
        value.get("event").is_some_and(serde_json::Value::is_string)
    } else if name.starts_with("tape-") {
        ["tape", "event", "mark", "plan", "doc", "proof", "stats"].iter().any(|key| value.get(key).is_some())
    } else { false }
}

fn runtime_log(path: &std::path::Path) -> bool {
    let name = path.file_name().unwrap_or_default().to_string_lossy();
    if path.extension().is_some_and(|e| e == "jsonl") {
        let root_log = path.parent().is_none_or(|p| p.as_os_str().is_empty())
            && ["engine-", "run-", "tape-"].iter().any(|prefix| name.starts_with(prefix));
        let attempt_log = matches!(path.parent().and_then(std::path::Path::to_str), Some("transcripts" | "checkpoints"))
            && name.trim_end_matches(".jsonl").rsplit_once("-h")
                .is_some_and(|(id, heat)| !id.is_empty() && !heat.is_empty() && heat.bytes().all(|b| b.is_ascii_digit()));
        return root_log || attempt_log;
    }
    let hexadecimal = |name: &str| name.len() == 16 && name.bytes().all(|b| b.is_ascii_hexdigit());
    if path.starts_with("checkpoints/objects") { return hexadecimal(&name); }
    if path.starts_with("tool-results") { return hexadecimal(name.trim_end_matches(".txt")); }
    if path.starts_with("bg") { return name.starts_with("bg-") && name.ends_with(".log"); }
    name.ends_with(".log") && name.len() > 16 && name.as_bytes()[..8].iter().all(u8::is_ascii_digit)
        && ["_FLUX_", "_STRIKE_", "_ASSAY_", "_SURVEY_", "_FOUNDER_", "_RESMELT_"].iter().any(|part| name.contains(part))
}

/// Paint a palette color for the stream-mode `print!` lines in this crate.
use std::collections::BTreeSet;
use std::ffi::OsString;
use std::io;
use std::path::{Component, Path, PathBuf};

pub fn install_ignores(root: &Path, commission: Option<&str>) -> io::Result<()> {
    let path = root.join(".gitignore");
    let mut body = match std::fs::read_to_string(&path) {
        Ok(body) => body,
        Err(e) if e.kind() == io::ErrorKind::NotFound => String::new(),
        Err(e) => return Err(e),
    };
    let mut stacks = [false; 3];
    let text = commission.unwrap_or_default().to_ascii_lowercase();
    for word in text.split(|c: char| !c.is_ascii_alphanumeric()) {
        match word {
            "python" | "python3" | "pytest" | "unittest" | "pip" | "py" => stacks[0] = true,
            "node" | "nodejs" | "npm" | "javascript" | "typescript" | "react" | "nextjs" | "js"
            | "ts" => stacks[1] = true,
            "rust" | "cargo" | "rs" => stacks[2] = true,
            _ => {}
        }
    }
    detect_stacks(root, 0, &mut 1_000, &mut stacks)?;
    let mut patterns = vec!["/logs/"];
    if stacks[0] {
        patterns.extend([
            "__pycache__/",
            "*.pyc",
            "*.pyo",
            ".pytest_cache/",
            ".mypy_cache/",
            ".ruff_cache/",
            ".venv/",
            "venv/",
            ".coverage",
            "htmlcov/",
            "build/",
            "dist/",
            "*.egg-info/",
        ]);
    }
    if stacks[1] {
        patterns.extend([
            "node_modules/",
            "dist/",
            "build/",
            ".next/",
            ".nuxt/",
            ".turbo/",
            "coverage/",
        ]);
    }
    if stacks[2] {
        patterns.push("target/");
    }
    let original_len = body.len();
    for pattern in patterns {
        if body
            .lines()
            .any(|line| line.trim() == pattern || pattern == "/logs/" && line.trim() == "logs/")
        {
            continue;
        }
        if !body.is_empty() && !body.ends_with('\n') {
            body.push('\n');
        }
        body.push_str(pattern);
        body.push('\n');
    }
    if body.len() != original_len {
        std::fs::write(path, body)?;
    }
    Ok(())
}

fn detect_stacks(
    root: &Path,
    depth: usize,
    budget: &mut usize,
    stacks: &mut [bool; 3],
) -> io::Result<()> {
    for entry in std::fs::read_dir(root)? {
        if *budget == 0 {
            break;
        }
        *budget -= 1;
        let entry = entry?;
        let kind = entry.file_type()?;
        let path = entry.path();
        let name = entry.file_name();
        let name = name.to_string_lossy();
        if kind.is_file() {
            match name.as_ref() {
                "pyproject.toml" | "requirements.txt" | "setup.py" | "Pipfile" => stacks[0] = true,
                "package.json" | "package-lock.json" | "pnpm-lock.yaml" | "yarn.lock" => {
                    stacks[1] = true
                }
                "Cargo.toml" | "Cargo.lock" => stacks[2] = true,
                _ => {}
            }
            match path.extension().and_then(|ext| ext.to_str()) {
                Some("py") => stacks[0] = true,
                Some("js" | "ts" | "jsx" | "tsx" | "mjs" | "cjs") => stacks[1] = true,
                Some("rs") => stacks[2] = true,
                _ => {}
            }
        } else if kind.is_dir()
            && depth < 2
            && !matches!(
                name.as_ref(),
                ".git"
                    | "logs"
                    | ".slag"
                    | "__pycache__"
                    | ".venv"
                    | "venv"
                    | "node_modules"
                    | "target"
                    | "build"
    let bands = crate::engine::prompt::build(
        Path::new("."),
        &model,
        crate::engine::prompt::PromptMode::Forge,
    );
    let flux_text = flux::prepare_flux(ingot, None);
    transcript::scope(
        ingot.id.clone(),
        ingot.heat,
        agent.run(bands.join(), flux_text),
    )
    .await
}

/// The strike's acceptance gate, factored for the resume path: extract
/// CMD, run it, verify the proof, commit. `Err` carries the slag line a
/// retry heat would have been fed.
async fn verify_and_seal(ingot: &Ingot, response: &str) -> Result<(), String> {
    let cmd = proof::extract_cmd(response).ok_or("NO CMD: line in response".to_string())?;
    let (ok, output) = run_verification(&cmd).await;
    if !ok {
        return Err(format!("CMD failed (exit 1): {output}"));
    }
    if !ingot.proof.is_empty() && ingot.proof != cmd && ingot.proof != "true" {
        let (proof_ok, proof_output) = run_verification(&ingot.proof).await;
        if !proof_ok {
            return Err(format!("Proof failed [{}]: {proof_output}", ingot.proof));
        }
    }
    if let Some(e) = crate::error::provider_run_failure() {
        return Err(e.to_string());
    }
    Ok(())
}

async fn run_verification(cmd: &str) -> (bool, String) {
    let check = check_verification(cmd).await;
    (check.success, check.output)
}

/// Run a CMD line or proof with the coordinator files protected, and keep
/// the shell's own verdict on whether the command could run at all.
async fn check_verification(cmd: &str) -> proof::ShellCheck {
    let refused = |output: String| proof::ShellCheck {
        success: false,
        output,
        broken: false,
        reason: String::new(),
    };
    if let Some(error) = crate::engine::agent::coordinator_command_error(cmd) {
        return refused(error.to_string());
    }
    let _guard = CRUCIBLE_LOCK.lock().await;
    let snapshot = match super::CoordinatorGuard::capture(Path::new(".")) {
        Ok(snapshot) => snapshot,
        Err(e) => return refused(format!("cannot protect coordinator files: {e}")),
    };
    if let Err(e) = super::hygiene::install_ignores(Path::new("."), None) {
        return refused(format!("cannot install cache ignores: {e}"));
    }
    let files = match super::hygiene::VerificationFiles::capture(Path::new(".")) {
        Ok(files) => files,
        Err(e) => return refused(format!("cannot snapshot verification files: {e}")),
    };
    let check = proof::check_shell(cmd).await;
    let restored = snapshot.restore();

