use super::events::{arg_summary, preview};
use super::tools::ToolBox;
use super::hooks;
use super::transcript::{self, TranscriptWriter};
use super::{
    emit, stats, CancelFlag, CancelReason, Cancellation, ChatMessage, ChatRequest, Effort,
    EngineEvent, EventTx, FinishReason, NormalizedResponse, Provider, RetryPolicy, Role,
    SteerQueue, ToolCall, ToolOutcome, ToolSpec, Usage,
};
use crate::error::SlagError;

const DEFAULT_MAX_TURNS: usize = 40;
const CHAR_BUDGET: usize = 48_000;
const RECENT_TOOL_ROUNDS: usize = 2;
const REVIEW_VIOLATION: &str = "review policy violation:";
/// chars/4 is the estimation rule for text appended since the last usage
/// anchor; token budgets convert to char targets through the same ratio.
pub(crate) const CHARS_PER_TOKEN: usize = 4;
const DEFAULT_TOKEN_BUDGET: usize = CHAR_BUDGET / CHARS_PER_TOKEN;
/// Room reserved out of the model window for its own output.
const OUTPUT_RESERVE_TOKENS: u64 = 16_384;
/// Headroom so compaction fires before the hard window edge.
const COMPACT_BUFFER_TOKENS: u64 = 8_192;
/// Compaction circuit breaker: after this many overflow-shrink cycles the
/// context is declared irrecoverable — a permanent failure, not a heat to
/// keep retrying against.
const MAX_SHRINK_CYCLES: usize = 3;
/// Warn when ingot spend crosses this fraction of the cost cap.
const COST_WARN_FRACTION: f64 = 0.8;
/// Overflow-shrink floor: below this, compaction cannot help — the
/// system prompt, task, and protected tail alone exceed the window.
const CHAR_BUDGET_FLOOR: usize = 16_000;
const TOKEN_BUDGET_FLOOR: usize = CHAR_BUDGET_FLOOR / CHARS_PER_TOKEN;
const PREVIEW_LEN: usize = 80;
const STEER_TAG: &str = "[STEER — operator message, follow it]";
/// Silent-escalation output cap: the first Length truncation retries the
/// same request once with this max_tokens before any continuation nudge.
const RAISED_MAX_TOKENS: u32 = 32_768;
/// Continuation nudges after the silent escalation, before failing.
const MAX_CONTINUE_NUDGES: usize = 3;
/// CC's proven continuation text: resume directly, no apology, no recap.
const CONTINUE_NUDGE: &str = "Continue your previous response from exactly where it was cut \
off — resume directly, no apology, no recap, do not repeat earlier output.";
/// Output room kept in reserve when shrinking max_tokens to fit a parsed
/// "input + output > limit" overflow.
const OUTPUT_SHRINK_BUFFER: u64 = 1_024;
/// Below this much output room, shrinking max_tokens cannot help — the
/// input itself must be compacted.
const MIN_SHRUNK_OUTPUT_TOKENS: u64 = 512;
/// Files re-read and re-injected after a summarization compaction.
const REINJECT_FILES: usize = 5;
/// Per-file char cap for post-compaction re-injection.
const REINJECT_FILE_CAP: usize = 20_000;
async fn direct_commission_protects_coordinator_state_and_seals_before_review() {
    let root = tempfile::tempdir().unwrap();
    let config = tempfile::tempdir().unwrap();
    let server = MockServer::start().await;
    let review_root = root.path().to_path_buf();
    Mock::given(method("POST"))
        .and(path("/chat/completions"))
        .respond_with(move |request: &wiremock::Request| {
            let body: Value = serde_json::from_slice(&request.body).unwrap();
            let messages = body["messages"].to_string();
            let results = tool_results(&body);
            if messages.contains("Choose the work scope") {
                assert!(results.is_empty());
                return response(json!({"content": json!({"direct": true, "proof": PROOF}).to_string()}));
            }
            if body["model"] == "test/work" {
                if results.is_empty() {
                    let mut calls = vec![
                        tool("source", "write_file", json!({"path": "wc.py", "content": SOURCE})),
                        tool("tests", "write_file", json!({"path": "test_wc.py", "content": TEST})),
                    ];
                    for name in ["PLAN.md", "PROGRESS.md", "BLUEPRINT.md", "BAR.md", "PRD.md", "AGENTS.md", "logs/attack.log"] {
                        calls.push(tool(name, "write_file", json!({"path": name, "content": "stale coordinator state"})));
                    }
                    calls.push(tool("restore", "bash", json!({"command": "git restore PLAN.md PROGRESS.md"})));
                    let stale = "(ingot :id \"i1\" :status ore :solo nil :grade 1 :heat 0 :max 3 :proof \"python3 -m unittest\" :work \"Count words\")";
                    let code = format!(
                        "from pathlib import Path; Path(\"PLAN\" + \".md\").write_text({}); Path(\"PROGRESS\" + \".md\").write_text(\"stale ledger\")",
                        serde_json::to_string(stale).unwrap()
                    );
                    calls.push(tool("indirect", "bash", json!({"command": format!("python3 -c '{code}'")})));
                    return response(json!({"content": null, "tool_calls": calls}));
                }
                assert_eq!(results.len(), 11, "{results:?}");
                assert!(results[2..9].iter().all(|r| r.contains("slag owns")), "{results:?}");
                assert!(results[9].contains("do not restore"), "{results:?}");
                assert!(results[10].contains("slag restored its coordinator files"), "{results:?}");
                return response(json!({"content": format!("CMD: {PROOF}")}));
            }
            assert!(messages.contains("# slag warden"), "unexpected preparation phase: {messages}");
            let names: Vec<_> = body["tools"].as_array().unwrap().iter()
                .map(|spec| spec["function"]["name"].as_str().unwrap()).collect();
            assert!(!names.contains(&"write_file"), "{names:?}");
            assert!(!names.contains(&"edit_file"), "{names:?}");
            assert!(!names.contains(&"finish"), "{names:?}");
            if results.is_empty() {
                assert!(git(&review_root, &["status", "--porcelain"]).is_empty());
                assert!(git(&review_root, &["show", "HEAD:PLAN.md"]).contains(":status forged"));
                assert!(git(&review_root, &["show", "HEAD:PROGRESS.md"]).contains("heats:1"));
                return response(json!({"content": null, "tool_calls": [
                    tool("inspect", "read_file", json!({"path": "wc.py"})),
                    tool("inspect-tests", "read_file", json!({"path": "test_wc.py"})),
                ]}));
            }
            assert_eq!(results.len(), 2, "{results:?}");
            assert!(results[0].contains("def count_words(path)"), "{results:?}");
            assert!(results[1].contains("assertEqual(wc.count_words"), "{results:?}");
            response(json!({"content": "VERDICT: pass\nEVIDENCE: read wc.py and test_wc.py; the test checks three words across two lines"}))
        })
        .expect(5)
        .mount(&server).await;

    command(root.path(), config.path(), &server)
        .assert()
        .success()
        .stdout(contains("FORGED"));
    let plan = std::fs::read_to_string(root.path().join("PLAN.md")).unwrap();
    assert_eq!(plan.matches("(ingot ").count(), 1, "{plan}");
    assert!(plan.contains(":status forged"), "{plan}");
    assert!(plan.contains(":heat 1"), "{plan}");
    assert_eq!(git(root.path(), &["show", "HEAD:PLAN.md"]), plan);
    let ledger = git(root.path(), &["show", "HEAD:PROGRESS.md"]);
    assert_eq!(ledger.matches("heats:1").count(), 1, "{ledger}");
    assert!(ledger.contains("Warden round 1"), "{ledger}");
    assert!(ledger.contains("goal met"), "{ledger}");
    assert!(!ledger.contains("stale ledger"), "{ledger}");
    assert_eq!(
        std::fs::read_to_string(root.path().join("AGENTS.md")).unwrap(),
        "## Alloy Recipes\n"
    );
    assert!(!root.path().join("logs/attack.log").exists());
    assert!(git(root.path(), &["status", "--porcelain"]).is_empty());
    server.verify().await;
}

