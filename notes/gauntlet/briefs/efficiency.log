"""Convert CSV text streams to JSON-compatible records."""

import argparse
import csv
import json
import sys


def convert(stream):
    """Read a header row and return records, preserving cells as strings."""
    return list(csv.DictReader(stream))


def main():
    parser = argparse.ArgumentParser(
        description="Convert CSV with a header row to a JSON array of objects."
    )
    parser.add_argument(
        "input", nargs="?", help="CSV file path (reads stdin when omitted)"
    )
    parser.add_argument(
        "--pretty", action="store_true", help="print indented, multiline JSON"
    )
    args = parser.parse_args()
    try:
        if args.input is None:
            records = convert(sys.stdin)
        else:
            with open(args.input, encoding="utf-8", newline="") as stream:
                records = convert(stream)
    except (OSError, UnicodeError, csv.Error) as error:
        parser.error(str(error))
    print(json.dumps(records, indent=2 if args.pretty else None))
