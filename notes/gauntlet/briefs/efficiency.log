import json, os, signal, subprocess, sys, time
from pathlib import Path
BASE=Path('/Users/stas/.claude/jobs/f353e9d3/tmp/efficiency-r4').resolve()
name=sys.argv[1];stack=sys.argv[2]
commissions={
'wc':'write wc.py that counts lines, words and bytes of a file like wc, with a unittest suite',
'csv':'a small Python CLI that converts CSV to JSON with a --pretty flag, in a package with tests',
'node':'a tiny Node CLI that prints the top N most frequent words of a text file, with node:test tests'}
root=BASE/name;root.mkdir();assert root.resolve().is_relative_to(BASE)
config=BASE/(name+'-config');config.mkdir()
env=os.environ.copy()
for key in list(env):
    if key.startswith('SLAG_'):del env[key]
env.update(SLAG_CONFIG_DIR=str(config),SLAG_MAX_COST_RUN='0.25',SLAG_MAX_COST_INGOT='0.20',TMPDIR=str(BASE/'tmp'),PYTHONDONTWRITEBYTECODE='1',NODE_DISABLE_COMPILE_CACHE='1',NO_COLOR='1')
binary=os.environ.get('R4_BINARY','/Users/stas/Playground/slag/.claude/worktrees/lane-efficiency/slag-rs/target/debug/slag')
args=[binary,commissions[stack],'--temper','1','--provider','openai'];start=time.monotonic();started=time.time();stop_reason=None
with (BASE/(name+'.stdout')).open('w') as stdout,(BASE/(name+'.stderr')).open('w') as stderr:
    proc=subprocess.Popen(args,cwd=root,env=env,stdout=stdout,stderr=stderr,start_new_session=True)
    while proc.poll() is None:
        output=(BASE/(name+'.stderr')).read_text().lower()
        if any(word in output for word in ['rate limit','status 429','http 429','insufficient_quota','status 402','http 402']):stop_reason='provider rate or quota limit'
        if time.monotonic()-start>180:stop_reason='180 second deadline'
        if stop_reason:
            os.killpg(proc.pid,signal.SIGTERM)
            try:proc.wait(timeout=5)
            except subprocess.TimeoutExpired:os.killpg(proc.pid,signal.SIGKILL)
            break
        time.sleep(.1)
    code=proc.wait()
wall=time.monotonic()-start;engines=[];cost=0
for p in sorted((root/'logs').glob('engine-*.jsonl')):
    events=[json.loads(line) for line in p.open()];usage=[d['usage'] for d in events if d.get('event')=='tokens']
    engines.append(dict(id=p.stem[7:],role=usage[0]['role'] if usage else None,prompt=sum(u['prompt_tokens'] for u in usage),completion=sum(u['completion_tokens'] for u in usage),calls=len(usage),models=sorted({u['model'] for u in usage})))
    cost+=sum(u.get('cost') or 0 for u in usage)
sessions=[];current=None;prompt=completion=0
for p in sorted((root/'logs').glob('tape-*.jsonl')):
    for line in p.open():
        d=json.loads(line)
        if d.get('event')=='context_gauge' and current is None:current=dict(start=d['t']/1000,role='',prompt=0,completion=0)
        if d.get('event')=='tokens':
            u=d['usage'];prompt+=u['prompt_tokens'];completion+=u['completion_tokens']
            if current:current['role']=u['role'];current['prompt']+=u['prompt_tokens'];current['completion']+=u['completion_tokens']
        if d.get('event')=='finish' and current:current['seconds']=d['t']/1000-current.pop('start');sessions.append(current);current=None
assert (prompt,completion)==(sum(e['prompt'] for e in engines),sum(e['completion'] for e in engines))
result=dict(name=name,argv=args,root=str(root),exit_code=code,seconds=wall,prompt=prompt,completion=completion,tokens=prompt+completion,cost_estimate=cost,sessions=sessions,engines=engines,stop_reason=stop_reason)
(BASE/(name+'.json')).write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result,indent=2));print('STDOUT:',(BASE/(name+'.stdout')).read_text()[-3500:]);print('STDERR:',(BASE/(name+'.stderr')).read_text()[-3000:]);sys.exit(code)
    output.status.success().then(|| String::from_utf8_lossy(&output.stdout).trim().to_string())
}

fn unverified_goal_round(path: &std::path::Path) -> Option<usize> {
    let ledger = std::fs::read_to_string(path).ok()?;
    let section = ledger.rsplit("## Warden round ").next()?;
    let header = section.lines().next()?;
    if !header.trim_end().ends_with("goal unverified") { return None; }
    header.split_whitespace().next()?.trim_end_matches(':').parse().ok()
}

fn pending_goal_gap(path: &std::path::Path) -> Option<(usize, String)> {
    let ledger = std::fs::read_to_string(path).ok()?;
    let section = ledger.rsplit("## Warden round ").next()?;
    let (header, body) = section.split_once('\n')?;
    if !header.trim_end().ends_with("goal not met") { return None; }
    let round = header.split_whitespace().next()?.trim_end_matches(':').parse().ok()?;
    let gap = body.lines().find_map(|line| line.strip_prefix("- gap: "))?.trim();
    if gap.is_empty() || gap == "—" || gap.contains("goal unverified")
        || gap.contains("no readable verdict") { return None; }
    Some((round, gap.to_string()))
}

fn empty_project(root: &std::path::Path) -> bool {
    let Ok(entries) = std::fs::read_dir(root) else { return false };
    entries.filter_map(Result::ok).all(|entry| {
        matches!(entry.file_name().to_str(), Some(".git" | ".gitignore" | "logs"))
    })
}

fn found_direct(commission: &str, plan: &direct::DirectPlan) -> Result<(), SlagError> {
    let checklist = plan.criteria.iter().map(|item| format!("- [ ] {item}")).collect::<Vec<_>>().join("\n");
    let commands: Vec<_> = std::iter::once(&plan.proof).chain(&plan.commands).cloned().collect();
    let checks = format!("REQUIRED RUN COMMANDS: {}", serde_json::to_string(&commands).unwrap());
    let contract = format!("## CHECKLIST\n{checklist}\n\n{checks}\n");
    std::fs::write(crate::config::BLUEPRINT, format!(
        "# Local utility\n\n{commission}\n\n{contract}"
    ))?;
    std::fs::write(warden::BAR_FILE, format!(
        "## THE BAR\nDeliver the named behavior in the original commission.\n\n{contract}\n\
         ## HOW TO INSPECT\n\
         Read the product and test source, then run the declared suite and CLI probes.\n\
         Run each required command as its own bash call, copied verbatim. Cite those successful run IDs in EVIDENCE.\n\
         Check each named behavior and flag through the actual CLI tests. Source inspection alone cannot pass this bar.\n\
         Use in-memory test data or committed fixtures under tests/fixtures. The reviewer cannot create fixtures or caches.\n\
         Judge the commission without extra naming, style, or test-count rules.\n"
    ))?;
    let mut ingot = crate::sexp::parser::parse_ingot("(ingot :id \"i1\")").unwrap();
    ingot.solo = false;
    ingot.grade = 1;
    ingot.max = 3;
    ingot.casts = Some(1);
    ingot.bar.clear();
    ingot.proof = plan.proof.clone();
    ingot.work = commission.to_string();
    Crucible::new(std::path::Path::new(crate::config::CRUCIBLE), vec![ingot]).save()?;
    Ok(())
}

/// Initialize project structure (fire the furnace)
/// Run a pre-forge goal check, returning the gap when the document does
/// not cover the bar. `None` means it passed, the check is disarmed, or the
/// warden could not run -- all three mean "carry on", because a check that
/// exists to save a wasted forge must never cause one.
async fn checkpoint(
    config: &EngineConfig,
    hooks: &EngineHooks,
    kind: &str,
    path: &str,
) -> Option<String> {
    if !warden::armed() {
        return None;
    }
    let verdict = match warden::judge_plan_doc(config, hooks, kind, path).await {
        Ok(v) => v,
        // A provider refusal is the run's error, reported once by `main`;
        // the next smith short-circuits on it.
        Err(e) if e.is_deterministic_provider() || crate::error::provider_run_failure().is_some() => {
            return None;
        }
        // Never silent. A checkpoint that cannot run used to disappear,
        // and a run with every check disabled still printed FORGED --
        // which is the laundering this whole mechanism exists to stop.
        Err(e) => {
            crate::engine::emit(
                &hooks.events,
                crate::engine::EngineEvent::Warning {
                    message: format!("the {kind} could not be judged: {e}"),
                },
            );
            return None;
        }
    };
    if verdict.fulfilled {
        return None;
    }
//! The warden: a fresh-context critic that judges whether the goal was met.
//!
//! `:proof` answers "did this task's artifact appear". Nothing answered "does
//! the thing we were asked for exist", and the finish summary that claimed it
//! was written by the smith that did the work — the builder grading itself.
//! The warden supplies the two pieces that were missing: a bar the work is
//! measured against, and a judge that never built anything.
//!
//! It is deliberately given tools. A warden reasoning from a summary is
//! grading a summary; this one runs the build, reads the files, and reports
//! what it actually saw.

use crate::config::{BLUEPRINT, EngineConfig, LEDGER, ORE_FILE};
use crate::smith::EngineHooks;
use crate::error::SlagError;
use crate::tui;

mod grounding;
pub(crate) use grounding::{InspectionLog, parse_grounded_verdict};

/// How many warden rounds this run was armed with. Ambient like
/// `tui::quiet` because it is one run-level integer read deep in the forge:
/// threading it through four signatures to reach a single `if` costs more
/// clarity than it buys.
static ROUNDS: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
static REVIEW_BASE: std::sync::Mutex<Option<String>> = std::sync::Mutex::new(None);

pub(crate) fn set_review_base(base: Option<String>) {
    *REVIEW_BASE.lock().unwrap_or_else(|e| e.into_inner()) = base.map(|hash| hash.trim().to_string()).filter(|hash| {
        matches!(hash.len(), 40 | 64) && hash.bytes().all(|c| c.is_ascii_hexdigit())
    });
}

/// Arm the goal checks for this run. 0 leaves every warden asleep.
pub fn set_rounds(n: usize) {
    ROUNDS.store(n, std::sync::atomic::Ordering::Relaxed);
}

/// Whether goal checking is armed.
pub fn armed() -> bool {
    ROUNDS.load(std::sync::atomic::Ordering::Relaxed) > 0
}

/// Where the derived acceptance bar lives, once, for every warden to read.
pub const BAR_FILE: &str = "BAR.md";

/// A warden's answer. Structured on purpose: a prose verdict drifts into
/// flattery, and the caller needs to branch on the result, not read it.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct Verdict {
    /// Did the artifact meet the bar?
    pub fulfilled: bool,
    /// The single biggest gap that still matters. Empty when fulfilled.
    /// One gap, not a list: twenty small notes produce twenty small edits
    /// and no jump in quality.
    pub gap: String,
    /// What the warden actually inspected — a path, a number, an
    /// observation. A verdict with no evidence is an opinion.
    pub evidence: String,
}

impl Verdict {
    pub fn unverified(reason: impl AsRef<str>) -> Self {
        let reason = reason.as_ref().trim();
        Self {
            fulfilled: false,
            gap: if is_unverified_report(reason) {
                reason.to_string()
            } else {
                format!("{reason}; goal unverified")
            },
            evidence: String::new(),
        }
    }

    pub fn is_unverified(&self) -> bool {
        !self.fulfilled && is_unverified_report(&self.gap)
    }
}

pub(crate) fn is_unverified_report(report: &str) -> bool {
    report.trim_end().ends_with("; goal unverified")
}

/// Parse the warden's report. Tolerant of surrounding prose, because a
/// model asked for three lines often delivers three lines and a paragraph.
///
/// An unreadable report leaves the goal unverified without rejecting the artifact.
pub fn parse_verdict(raw: &str) -> Verdict {
    let mut fulfilled = None;
    let mut unverified = false;
    let mut gap = String::new();
    let mut evidence = String::new();
    for line in raw.lines() {
        let line = line.trim().trim_start_matches(['#', '*', '-', ' ']);
        let Some((key, value)) = line.split_once(':') else { continue };
        // Models decorate. `**VERDICT:** fail` leaves the bold on the value.
        let value = value.trim_matches(|c: char| c == '*' || c == '_' || c == '`').trim();
        let key = key.trim_matches(|c: char| c == '*' || c == '_' || c == '`').trim();
        match key.to_ascii_uppercase().as_str() {
            "VERDICT" => {
                // The whole word, not a prefix: `passable-ish` is a hedge,
                // and a hedge must not clear the goal gate.
                let word = value
                    .split_whitespace()
                    .next()
                    .unwrap_or_default()
                    .trim_matches(|c: char| !c.is_ascii_alphabetic())
                    .to_ascii_lowercase();
                match word.as_str() {
                    "pass" => fulfilled = Some(true),
                    "fail" => fulfilled = Some(false),
                    "unverified" => unverified = true,
                    _ => {}
                }
            }
            "GAP" if gap.is_empty() => gap = value.to_string(),
            "EVIDENCE" if evidence.is_empty() => evidence = value.to_string(),
            _ => {}
        }
    }
    if unverified {
        let mut verdict = Verdict::unverified(if gap.is_empty() { "the warden could not complete its inspection" } else { &gap });
        verdict.evidence = evidence;
        return verdict;
    }
    match fulfilled {
        Some(true) if !evidence.trim().is_empty() => Verdict { fulfilled: true, gap: String::new(), evidence },
        Some(true) => Verdict::unverified("the warden returned a pass without inspection evidence"),
        Some(false) if gap.is_empty() => Verdict::unverified("the warden reported a failure without naming a gap"),
        Some(false) => Verdict { fulfilled: false, gap, evidence },
        None => Verdict::unverified("the warden returned no readable verdict"),
    }
}

