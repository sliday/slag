env.update(SLAG_CONFIG_DIR=str(config),SLAG_MAX_COST_RUN='0.15',SLAG_MAX_COST_INGOT='0.12',TMPDIR=str(BASE/'tmp'),PYTHONDONTWRITEBYTECODE='1',NO_COLOR='1')
