/// The warden's word on the goal: `✓ warden · round 1  goal met — …` or
/// `✗ warden · round 1  <gap>`, wrapped under itself.
fn warden_lines(message: &str, word: &str, width: usize) -> Vec<String> {
    let round = message
        .strip_prefix("warden round ")
        .and_then(|r| r.split(':').next())
        .unwrap_or("?");
    let met = word.starts_with("goal met");
    let (glyph, color) = if met { ("✓", PURE) } else { ("✗", WARM) };
    let head = format!(
        "  {} {} {}  ",
        paint(color, glyph),
        paint(color, "warden"),
        dim(&format!("round {round}"))
    );
    let body = if met { word.to_string() } else { format!("goal not met — {word}") };
    wrap_hanging(&head, &body, width, 4, 3)
}

/// Cross-narrator live-line state. Parallel anvils each spawn their own
/// narrator (one per smith invocation), and every `RenderState` only knows
/// about its *own* live line — without shared state, narrator B's Print
/// lands at the cursor parked mid-way through narrator A's un-terminated
/// live line and A's next `\r` rewrite overwrites B's card. The mutex
/// serializes stderr writes; the flag records whether ANY narrator holds
/// an un-terminated live line so the next writer clears it first.
static STDERR_LIVE: std::sync::Mutex<bool> = std::sync::Mutex::new(false);

/// Apply render ops to stderr. The only place the narrator touches a
/// terminal; IO errors are swallowed (display must never kill the forge).
pub(crate) fn apply_ops(ops: &[RenderOp]) {
    let mut live = STDERR_LIVE.lock().unwrap_or_else(|p| p.into_inner());
    let mut err = std::io::stderr().lock();
    let refused = |message: String| ToolOutcome { output: message, is_error: true };
    if read_only && !review_tool(&call.name) {
        return refused(format!("{REVIEW_VIOLATION} {} is unavailable during review", call.name));
    }
    if read_only && call.name == "bash" {
        return review_shell(call, root).await;
    }
    let Some(root) = root else {
        return toolbox.dispatch(call).await;
    };
    if let Some((path, true)) = ToolBox::path_access(call) {
        let path = root.join(path);
        let resolved = path.canonicalize().unwrap_or(path);
        let relative = resolved.strip_prefix(root).unwrap_or(&resolved);
        if coordinator_path(relative) {
            return refused("slag owns this coordinator file; change only artifact files".into());
        }
    }
    if call.name == "bash" {
        if let Ok(args) = serde_json::from_str::<serde_json::Value>(&call.arguments) {
            if args.get("run_in_background").and_then(serde_json::Value::as_bool) == Some(true) {
                return refused("run commands in the foreground so slag can protect coordinator files".into());
            }
            if let Some(reason) = args.get("command").and_then(serde_json::Value::as_str)
                .and_then(coordinator_command_error)
            {
                return refused(reason.into());
            }
        }
    }
    if ToolBox::path_access(call).is_some_and(|(_, writer)| !writer) || call.name == "finish" {
        return toolbox.dispatch(call).await;
    }
    let _lock = crate::crucible::CRUCIBLE_LOCK.lock().await;
    let guard = match crate::pipeline::CoordinatorGuard::capture(root) {
        Ok(guard) => guard,
        Err(e) => return refused(format!("cannot protect coordinator files: {e}")),
    };
    let mut result = toolbox.dispatch(call).await;
    match guard.restore() {
        Ok(changed) if !changed.is_empty() => {
            result.is_error = true;
            result.output.push_str(&format!(
                "\nslag restored its coordinator files: {}. Change only artifact files.",
                changed.join(", ")
            ));
        }
        Err(e) => return refused(format!("cannot restore coordinator files: {e}")),
        _ => {}
    }
    result
}

async fn review_shell(call: &ToolCall, root: Option<&std::path::Path>) -> ToolOutcome {
    use std::process::Stdio;
    let violation = |message: String| ToolOutcome {
        output: format!("{REVIEW_VIOLATION} {message}"), is_error: true,
    };
    let Some(root) = root else { return violation("review has no workspace root".into()); };
    let args: serde_json::Value = match serde_json::from_str(&call.arguments) {
        Ok(args) => args,
        Err(e) => return violation(format!("invalid shell arguments: {e}")),
    };
    let Some(command) = args.get("command").and_then(serde_json::Value::as_str) else {
        return violation("review shell needs a command".into());
    };
    if args.get("run_in_background").and_then(serde_json::Value::as_bool) == Some(true) {
        return violation("background commands are forbidden during review".into());
    }
    if let Some(reason) = review_command_error(command) { return violation(reason.into()); }
    let sandbox = match super::sandbox::Sandbox::read_only() {
        Ok(sandbox) => sandbox,
        Err(e) => return violation(e.to_string()),
    };
    let timeout = args.get("timeout").and_then(serde_json::Value::as_u64).unwrap_or(20).clamp(1, 30);
    let mut cmd = sandbox.wrap("/bin/sh");
    cmd.args(["-c", command]).current_dir(root)
        .env("PYTHONDONTWRITEBYTECODE", "1")
        .env("PIP_NO_INDEX", "1")
        .env("PIP_DISABLE_PIP_VERSION_CHECK", "1")
        .stdin(Stdio::null()).stdout(Stdio::piped()).stderr(Stdio::piped()).kill_on_drop(true);
    #[cfg(unix)]
    cmd.process_group(0);
    let child = match cmd.spawn() {
        Ok(child) => child,
        Err(e) => return violation(format!("cannot start read-only shell: {e}")),
            SandboxMode::Off => Self::off(),
            SandboxMode::Auto => Self::new(root, &extras),
        }
    }

    /// Confine writes to `root`, temp, tool caches and `extras` with the
    /// backend this machine supports.
    pub fn new(root: &Path, extras: &[PathBuf]) -> Self {
        let home = std::env::var_os("HOME").map(PathBuf::from);
        let tmpdir = std::env::var_os("TMPDIR")
            .map(PathBuf::from)
            .unwrap_or_else(std::env::temp_dir);
        let mut env_caches = Vec::new();
        for (var, parts) in CACHE_ENV {
            let Some(base) = std::env::var_os(var).filter(|v| !v.is_empty()) else {
                continue;
            };
            env_caches.extend(parts.iter().map(|p| PathBuf::from(&base).join(p)));
        }
        let writable = writable_paths(root, extras, home.as_deref(), Some(&tmpdir), &env_caches);
        let private = PRIVATE_GIT_DIRS
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .clone();
        let locked = locked_git_paths(root, &private);
        Self::with(backend(), writable, locked)
    }

    fn with(backend: Backend, writable: Vec<PathBuf>, locked: Locked) -> Self {
        // Landlock grants whole trees and cannot carve a read-only file out
        // of one, so there the git guard watches the locked files instead.
        #[cfg(target_os = "linux")]
        if let (Backend::Landlock, Some(root)) = (backend, writable.first()) {
            git_guard::record(root, &locked);
        }
        #[cfg(target_os = "linux")]
        let (backend, ruleset) = match backend {
            // A ruleset the kernel refused leaves nothing to enforce.
            Backend::Landlock => match landlock::ruleset(&writable) {
                Some(fd) => (backend, Some(fd)),
                None => (Backend::None, None),
            },
            _ => (backend, None),
        };
        Self {
            backend,
            writable,
            locked,
            read_only: false,
            #[cfg(target_os = "linux")]
            ruleset,
        }
    }

    pub fn backend(&self) -> Backend {
        self.backend
    }

    /// `sh -lc <script>`, wrapped in this sandbox.
    pub fn command(&self, script: &str) -> Command {
        let mut cmd = self.wrap("sh");
        cmd.arg("-lc").arg(script);
        cmd
    }

    /// `program` under this sandbox; the caller adds its arguments.
    pub fn wrap(&self, program: &str) -> Command {
        Command::from(self.wrap_std(program))
    }

    /// `wrap` for synchronous callers. The sandbox must outlive the spawn:
    /// under Landlock the child applies its ruleset fd between fork and exec.
    pub fn wrap_std(&self, program: &str) -> std::process::Command {
