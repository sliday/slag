+fn found_direct(commission: &str, proof: &str) -> Result<(), SlagError> {
+    std::fs::write(crate::config::BLUEPRINT, format!(
+        "# Local utility\n\n{commission}\n\nVerification: `{proof}`\n"
+    ))?;
+    std::fs::write(warden::BAR_FILE, format!(
