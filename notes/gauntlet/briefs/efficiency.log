+        std::fs::write(dir.path().join("utility.py"), "print(1)\n").unwrap();
+        assert_eq!(guard.restore().unwrap().len(), 3);
+        assert_eq!(std::fs::read_to_string(dir.path().join("PLAN.md")).unwrap(), "forged i1\n");
