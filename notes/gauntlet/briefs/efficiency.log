pub(crate) fn parse_grounded_verdict(raw: &str, inspections: &InspectionLog, require_runs: bool, required_commands: &[String]) -> Verdict {
    let mut verdict = parse_verdict(raw);
    if verdict.is_unverified() {
        verdict.evidence.clear();
        return verdict;
    }
    let ids = match serde_json::from_str::<Vec<String>>(&verdict.evidence) {
        Ok(ids) if !ids.is_empty() => ids,
        _ => return Verdict::unverified("the warden evidence must cite successful inspection IDs as a JSON array"),
    };
    let mut evidence = Vec::new();
    let mut commands = Vec::new();
    for id in ids {
        match inspections.results.get(&id).and_then(Option::as_ref) {
            Some(inspection) => {
                evidence.push(format!("[{}] {}", serde_json::to_string(&id).unwrap(), inspection.label));
                if !inspection.zero_tests {
                    if let Some(command) = &inspection.command { commands.push(command); }
                }
            },
            None => return Verdict::unverified(format!("the warden cited a failed, repeated, or unperformed inspection: {}", serde_json::to_string(&id).unwrap())),
        }
    }
    if verdict.fulfilled && require_runs {
        if commands.is_empty() {
            return Verdict::unverified("the warden pass has no successful check run in its evidence");
        }
        for required in required_commands {
            if !commands.iter().any(|command| same_check(command, required)) {
                return Verdict::unverified(format!("the warden did not cite a successful required run: {}", serde_json::to_string(required).unwrap()));
            }
        }
    }
    verdict.evidence = evidence.join("; ");
    verdict
}
use thiserror::Error;

/// Provider failure classes, assigned once where the HTTP response is in
/// hand (`engine::provider`). The dashboard and JSONL logs show the human
/// label instead of a raw body excerpt.
#[derive(Debug, Clone, Copy, PartialEq, Eq, serde::Serialize)]
#[serde(rename_all = "snake_case")]
pub enum ProviderErrorCategory {
    /// 401/403 — the key itself was refused.
    Auth,
    /// 402 — the account has no credit.
    Billing,
    /// 429 — rate limited.
    RateLimit,
    /// 529/503-style capacity shedding.
    Overloaded,
    /// 400/404/422 — the request itself is wrong.
    InvalidRequest,
    /// Other 5xx.
    Server,
    /// Connect/timeout/reset before any HTTP status arrived.
    Network,
    /// A 200 whose body could not be used (malformed or empty).
    BadResponse,
}

impl ProviderErrorCategory {
    /// Human-readable label for dashboards and logs.
    pub fn label(&self) -> &'static str {
        match self {
            ProviderErrorCategory::Auth => "invalid key",
            ProviderErrorCategory::Billing => "credit balance low",
            ProviderErrorCategory::RateLimit => "rate limited",
            ProviderErrorCategory::Overloaded => "overloaded",
            ProviderErrorCategory::InvalidRequest => "invalid request",
            ProviderErrorCategory::Server => "server error",
            ProviderErrorCategory::Network => "network error",
            ProviderErrorCategory::BadResponse => "malformed response",
        }
    }
}

/// One classified provider failure. Classification happens exactly once,
/// in `engine::provider`; everything downstream branches on the fields
/// instead of grepping a message string.
#[derive(Debug, Clone, PartialEq)]
pub struct ProviderApiError {
    /// HTTP status, when one arrived.
    pub status: Option<u16>,
    pub category: ProviderErrorCategory,
    /// Whether retrying the same call may succeed.
    pub retryable: bool,
    /// Body excerpt (plus any remedy text) kept for bug reports.
    pub excerpt: String,
}

impl std::fmt::Display for ProviderApiError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{}", self.category.label())?;
        if let Some(status) = self.status {
            write!(f, " ({status})")?;
        }
        if !self.excerpt.is_empty() {
            write!(f, ": {}", self.excerpt)?;
        }
    if !header.trim_end().ends_with("goal unverified") { return None; }
    header.split_whitespace().next()?.trim_end_matches(':').parse().ok()
}

fn pending_goal_gap(path: &std::path::Path) -> Option<(usize, String)> {
    let ledger = std::fs::read_to_string(path).ok()?;
    let section = ledger.rsplit("## Warden round ").next()?;
    let (header, body) = section.split_once('\n')?;
    if !header.trim_end().ends_with("goal not met") { return None; }
    let round = header.split_whitespace().next()?.trim_end_matches(':').parse().ok()?;
    let gap = body.lines().find_map(|line| line.strip_prefix("- gap: "))?.trim();
    if gap.is_empty() || gap == "—" || gap.contains("goal unverified")
        || gap.contains("no readable verdict") { return None; }
    Some((round, gap.to_string()))
}

fn empty_project(root: &std::path::Path) -> bool {
    let Ok(entries) = std::fs::read_dir(root) else { return false };
    entries.filter_map(Result::ok).all(|entry| {
        matches!(entry.file_name().to_str(), Some(".git" | ".gitignore" | "logs" | ".slag"))
    })
}

fn found_direct(commission: &str, plan: &direct::DirectPlan) -> Result<(), SlagError> {
    for (path, content) in &plan.fixtures {
        std::fs::create_dir_all(std::path::Path::new(path).parent().unwrap())?;
        std::fs::write(path, content)?;
    }
    let checklist = plan.criteria.iter().map(|item| format!("- [ ] {item}")).collect::<Vec<_>>().join("\n");
    let commands: Vec<_> = std::iter::once(&plan.proof).chain(&plan.commands).cloned().collect();
    let checks = format!("REQUIRED RUN COMMANDS: {}", serde_json::to_string(&commands).unwrap());
    let contract = format!("## CHECKLIST\n{checklist}\n\n{checks}\n");
    std::fs::write(crate::config::project_path(crate::config::BLUEPRINT), format!(
        "# Local utility\n\n{commission}\n\n{contract}"
    ))?;
    std::fs::write(crate::config::project_path(warden::BAR_FILE), format!(
        "## THE BAR\nDeliver the named behavior in the original commission.\n\n{contract}\n\
         ## HOW TO INSPECT\n\
         Read the product and test source, then run the declared suite and CLI probes.\n\
         Run each required check in its own bash call. Known test output flags may differ. Preserve the program, suite selection, and CLI arguments. Cite those successful run IDs in EVIDENCE.\n\
         Check each named behavior and flag through the actual CLI tests. Source inspection alone cannot pass this bar.\n\
         Use in-memory test data or committed fixtures under tests/fixtures. The reviewer cannot create fixtures or caches.\n\
         Judge the commission without extra naming, style, or test-count rules.\n"
    ))?;
    let mut ingot = crate::sexp::parser::parse_ingot("(ingot :id \"i1\")").unwrap();
    ingot.solo = false;
    ingot.grade = 1;
    ingot.max = 3;
    ingot.casts = Some(1);
    ingot.bar.clear();
    ingot.proof = commands.iter().map(|command| format!("( {command} )")).collect::<Vec<_>>().join(" && ");
    ingot.work = commission.to_string();
    Crucible::new(std::path::Path::new(crate::config::project_path(crate::config::CRUCIBLE)), vec![ingot]).save()?;
    Ok(())
}

