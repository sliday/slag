            break
        time.sleep(.1)
    code=proc.wait()
wall=time.monotonic()-start
if server:server.shutdown()
engines=[];cost=0
for p in sorted((root/'logs').glob('engine-*.jsonl')):
    if p.stat().st_mtime<started:continue
    events=[json.loads(line) for line in p.open()];usage=[d['usage'] for d in events if d.get('event')=='tokens']
    engines.append(dict(id=p.stem[7:],role=usage[0]['role'] if usage else None,prompt=sum(u['prompt_tokens'] for u in usage),completion=sum(u['completion_tokens'] for u in usage),calls=len(usage),models=sorted({u['model'] for u in usage})))
    cost+=sum(u.get('cost') or 0 for u in usage)
sessions=[];current=None;prompt=completion=0
